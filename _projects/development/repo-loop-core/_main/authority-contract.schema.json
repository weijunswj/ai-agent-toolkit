{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo-loop-core.authority.v1",
  "title": "Repository Loop Core Authority Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "candidate", "design_lock", "risk_tier", "local_evidence", "remote_evidence", "authority_digest"],
  "properties": {
    "schema_version": { "const": "repo-loop-core.authority.v1" },
    "repository": { "$ref": "#/$defs/repository" },
    "candidate": { "$ref": "#/$defs/identity" },
    "design_lock": { "$ref": "#/$defs/designLock" },
    "risk_tier": { "enum": ["T0", "T1", "T2", "T3"] },
    "local_evidence": { "$ref": "#/$defs/evidence" },
    "remote_evidence": { "$ref": "#/$defs/evidence" },
    "current_operation_time": { "$ref": "#/$defs/time" },
    "authority_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_id", "remote_url", "child", "pull_request", "branch", "base", "merge_base", "head", "tree"],
      "properties": {
        "repository_id": { "type": "string", "pattern": "^\\S+/\\S+$" }, "remote_url": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*://[^/]*@)" },
        "child": { "type": "integer", "minimum": 1 }, "pull_request": { "type": "integer", "minimum": 1 }, "branch": { "type": "string", "minLength": 1 },
        "base": { "$ref": "#/$defs/sha" }, "merge_base": { "$ref": "#/$defs/sha" }, "head": { "$ref": "#/$defs/sha" }, "tree": { "$ref": "#/$defs/sha" }
      }
    },
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["id", "remote_url"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "remote_url": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*://[^/]*@)" } }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["available", "repository_id", "remote_url", "child", "pull_request", "branch", "base", "merge_base", "head", "tree"],
      "properties": {
        "available": { "const": true }, "repository_id": { "type": "string", "pattern": "^\\S+/\\S+$" }, "remote_url": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*://[^/]*@)" },
        "child": { "type": "integer", "minimum": 1 }, "pull_request": { "type": "integer", "minimum": 1 }, "branch": { "type": "string", "minLength": 1 },
        "base": { "$ref": "#/$defs/sha" }, "merge_base": { "$ref": "#/$defs/sha" }, "head": { "$ref": "#/$defs/sha" }, "tree": { "$ref": "#/$defs/sha" }
      }
    },
    "designLock": {
      "type": "object", "additionalProperties": false, "required": ["id", "scope_id"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "scope_id": { "type": "string", "minLength": 1 } }
    },
    "time": {
      "type": "object", "additionalProperties": false, "required": ["source", "observed_at", "evidence_id"],
      "properties": { "source": { "const": "trusted-controller" }, "observed_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" }, "evidence_id": { "type": "string", "minLength": 1 } }
    }
  }
}
