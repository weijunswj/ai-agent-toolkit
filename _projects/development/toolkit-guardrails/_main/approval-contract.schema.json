{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.guardrail.approval.v1",
  "title": "Toolkit Trusted Approval Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "host",
    "source",
    "trusted_user_channel",
    "exact_operation_digest",
    "exact_targets_digest",
    "canonical_target_set",
    "session_id",
    "turn_id",
    "call_id",
    "operation_class",
    "issued_at",
    "expires_at",
    "one_shot",
    "consumed"
  ],
  "properties": {
    "contract_version": { "const": "toolkit.guardrail.approval.v1" },
    "host": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "trusted_user_channel": { "type": "string", "minLength": 1 },
    "exact_operation_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "exact_targets_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canonical_target_set": { "type": "array", "items": { "type": "object" } },
    "session_id": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "minLength": 1 },
    "call_id": { "type": "string", "minLength": 1 },
    "operation_class": { "type": "string", "minLength": 1 },
    "issued_at": { "type": ["string", "integer"] },
    "expires_at": { "type": ["string", "integer"] },
    "one_shot": { "type": "boolean" },
    "consumed": { "type": "boolean" },
    "consumed_count": { "type": "integer", "minimum": 0 },
    "max_repeat_count": { "type": "integer", "minimum": 1 },
    "replay_detected": { "type": "boolean" }
  }
}
