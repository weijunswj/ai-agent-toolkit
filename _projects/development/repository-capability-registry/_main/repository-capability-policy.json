{
  "schema": "toolkit.repository-capability-registry.v2",
  "schema_version": 2,
  "identity_contract": {
    "id": "toolkit.repository-identity.v1",
    "remote_contract": "toolkit.control-plane.remote-identity.v1",
    "key": "sha256(canonicalSerialize(identity_contract, remote_contract, canonical_remote))",
    "persisted_fields": ["repository_id"],
    "forbidden_identity_inputs": ["local_path", "worktree_path", "raw_remote", "remote_userinfo"]
  },
  "capability_contract": "toolkit.repository-capability.v2",
  "capabilities": [
    {
      "id": "repository.governance",
      "effect_id": "repository-governance-local-managed-materials-only",
      "boundary_id": "no-github-provider-live-or-unrelated-capability-authority",
      "question_id": "repository.governance.question",
      "choice_semantic_ids": ["repository.governance.decline", "repository.governance.enable"],
      "decision_semantic_ids": ["repository.governance.decline", "repository.governance.enable", "repository.governance.disable", "repository.governance.reopen"]
    },
    {
      "id": "execution_loop",
      "effect_id": "future-a3-supported-user-requested-loop-routing-only",
      "boundary_id": "no-governance-github-provider-live-or-unrelated-capability-authority",
      "question_id": "execution_loop.question",
      "choice_semantic_ids": ["execution_loop.decline", "execution_loop.enable"],
      "decision_semantic_ids": ["execution_loop.decline", "execution_loop.enable", "execution_loop.disable", "execution_loop.reopen"]
    },
    {
      "id": "repository.protection",
      "effect_id": "n6-repository-protection-reconciliation-consent-only",
      "boundary_id": "no-ci-gate-finality-or-live-provider-authority",
      "question_id": "repository.protection.question",
      "choice_semantic_ids": ["repository.protection.decline", "repository.protection.enable"],
      "decision_semantic_ids": ["repository.protection.decline", "repository.protection.enable", "repository.protection.disable", "repository.protection.reopen"],
      "scopes": ["inspect", "ci-enrolment", "publisher-enrolment", "required-check-activation", "protection-mutation", "drift-repair", "rollback"]
    }
  ],
  "protection": {
    "consent_only": true,
    "a1_required_for_provider_mutation": true,
    "default_state": "unresolved",
    "drift_repair_default": "disabled",
    "scope_system": "a2-capability-contract-only"
  },
  "runtime_states": ["unresolved", "enabled", "disabled"],
  "durable_states": ["enabled", "disabled"],
  "transitions": [
    "disabled->enable->enabled",
    "enabled->disable->disabled",
    "enabled->enable->enabled",
    "disabled->disable->disabled",
    "unresolved->decline->disabled",
    "unresolved->enable->enabled"
  ],
  "registry": {
    "path": "~/.ai-agent-toolkit/user-state/repository-governance.v1.json",
    "basename_is_storage_locator_only": true,
    "max_complete_bytes": 1048576,
    "max_repositories": 128,
    "max_capabilities_per_repository": 3,
    "migration_state": "version-dispatched-local-only",
    "receipt_policy": "one_compact_current_receipt_per_capability",
    "receipt_is_authority": false,
    "legacy_receipts": "preserve-exactly-and-validate-with-frozen-v1-tuple"
  },
  "quiet_entry": {
    "healthy_requirements": ["exact_local_repository_identity", "valid_current_v2_registry_schema", "current_v2_authority_contract", "governance_and_execution_loop_answered"],
    "protection_unresolved_is_healthy_entry_state": true,
    "protection_question_requires_explicit_route": true,
    "healthy_effects": {"model_calls": 0, "network_calls": 0, "writes": 0, "visible_output": 0, "repeated_policy_prose": 0},
    "forbidden_healthy_calls": ["bridge", "native_host_hooks", "github", "provider", "renderer"]
  },
  "migration": {
    "schema": "toolkit.repository-capability-registry.migration.v1",
    "algorithm": "v1-to-v2-local-atomic",
    "owner_decision": false,
    "revision_preserved": true,
    "snapshot_hash_changes": true,
    "receipt_payload_duplication": false,
    "foreign_or_uncertain_lock_takeover": false,
    "blind_retry": false
  },
  "codex_review": {
    "owned_by": "N5",
    "a2_consent_controlled": false,
    "default_preference": "enabled_unless_explicitly_owner_disabled",
    "absence_or_service_failure_persists_disabled": false
  },
  "forbidden_persistent_data": ["credentials", "secret_values", "prompts", "question_prose", "repository_contents", "unrestricted_tool_output", "raw_private_paths", "raw_remotes", "remote_userinfo", "environment_values"]
}
