{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "policy_id": "toolkit-issue-governance",
  "policy_version": "2.0.0",
  "policy_version_policy": "semver",
  "title": "Toolkit Global Issue-Governance Standard",
  "description": "Canonical machine-readable policy for Toolkit-governed repository issue tracking.",
  "effective_date": "2026-07-26",
  "authority": "Issue #299 — TK-032",
  "governance_modes": {
    "toolkit_governed": {
      "description": "The global standard applies.",
      "enforcement": "advisory_audit"
    },
    "repository_native": {
      "description": "The repository's own issue process remains authoritative.",
      "enforcement": "none"
    },
    "unknown": {
      "description": "Governance mode must be selected.",
      "enforcement": "report_only"
    }
  },
  "issue_categories": {
    "canonical_parent_tracker": {
      "description": "Concise checklist-first programme queue. One per governed repository.",
      "required": true,
      "max_per_repository": 1
    },
    "active_multi_step_child": {
      "description": "Full comprehensive standard for material tasks. Retained when closed.",
      "is_implementation_work": true,
      "required_sections": [
        "current_status", "reconciliation_timestamp", "parent_tracker",
        "implementation_branch", "implementation_pr", "dependencies", "blockers",
        "related_work", "why_this_issue_exists", "goal_and_scope", "completed_work",
        "current_blockers_and_findings", "remaining_steps", "acceptance_criteria",
        "linked_prs_and_followups", "decisions_and_durable_evidence", "safety_and_authority"
      ]
    },
    "small_atomic_child": {
      "description": "Reduced standard for small tasks. Retained when closed.",
      "is_implementation_work": true,
      "required_sections": [
        "current_status", "reconciliation_timestamp", "parent_link",
        "implementation_branch", "implementation_pr",
        "why_this_issue_exists", "completed_work", "blockers",
        "remaining_work", "acceptance_criteria", "linked_prs_or_followups", "safety_and_authority"
      ]
    },
    "recurring_evidence_log": { "description": "Latest verdict first with bounded historical evidence.", "is_implementation_work": false },
    "superseded_duplicate_not_planned": { "description": "Reason and successor recorded before closure.", "is_implementation_work": false }
  },
  "reconciliation_timestamp": {
    "format": "Last reconciled: **DD Month YYYY, HH:mm SGT**",
    "timezone": "Asia/Singapore",
    "time_format": "24-hour to the minute",
    "suffix": "SGT",
    "rules": [
      "Exactly one timestamp per issue body.",
      "Replace the previous timestamp rather than stacking.",
      "Advance only after substantive reconciliation.",
      "Comments and GitHub edit history preserve chronology."
    ]
  },
  "authority_model": {
    "web_controller_default": [
      "issue_body_reconciliation", "parent_status_changes", "parent_checklist_completion",
      "acceptance_decisions", "closure_or_reopening", "successor_decisions",
      "verification_that_review_findings_resolved"
    ],
    "coding_agent_default": [
      "read_parent_and_child_issues", "implement_scoped_repository_task",
      "report_exact_evidence", "propose_clean_replacement_text",
      "propose_concise_parent_status_line_update"
    ],
    "coding_agent_prohibited": [
      "rewrite_live_issue", "tick_parent_checklist_item",
      "mark_acceptance_criteria_independently_verified", "change_reconciliation_timestamp",
      "close_or_reopen_issue", "declare_own_implementation_accepted",
      "resolve_review_findings", "modify_tracker_issues"
    ]
  },
  "implementation_pr_lifecycle": {
    "description": "One issue, one branch, one active implementation PR.",
    "rules": [
      "One implementation issue maps to one branch and one active implementation PR.",
      "Amendments remain on the same PR.",
      "Replacement PRs require recorded exceptional reason and explicit supersession.",
      "Body and structured implementation-PR metadata must agree.",
      "Research, architecture-only and recurring-evidence issues are not required to have implementation PRs."
    ],
    "states": ["draft", "open", "closed", "merged"],
    "active_states": ["draft", "open"],
    "terminal_states": ["closed", "merged"],
    "max_active": 1
  },
  "finding_codes": {
    "GOV001": {
      "description": "toolkit_governed_no_canonical_parent",
      "severity": "error",
      "group": "parent_tracker",
      "messages": {
        "no_canonical_parent": {
          "template": "Toolkit-governed repository has no declared canonical parent tracker.",
          "context": {}
        }
      }
    },
    "GOV002": {
      "description": "toolkit_governed_multiple_canonical_parents",
      "severity": "error",
      "group": "parent_tracker",
      "messages": {
        "multiple_canonical_parents": {
          "template": "Toolkit-governed repository has {count} canonical parent trackers.",
          "context": {
            "count": { "type": "integer", "minimum": 0, "maximum": 10000 }
          }
        }
      }
    },
    "GOV003": {
      "description": "parent_checklist_entry_no_linked_child",
      "severity": "warning",
      "group": "parent_child_link",
      "messages": {
        "no_linked_child": {
          "template": "Parent checklist entry has no linked child.",
          "context": {}
        }
      }
    },
    "GOV004": {
      "description": "active_child_no_parent_link",
      "severity": "error",
      "group": "parent_child_link",
      "messages": {
        "no_parent_link": {
          "template": "Child issue has no parent link.",
          "context": {}
        }
      }
    },
    "GOV005": {
      "description": "active_child_absent_from_parent_checklist",
      "severity": "error",
      "group": "parent_child_link",
      "messages": {
        "child_absent_from_parent_checklist": {
          "template": "Children absent from parent body checklist.",
          "context": {}
        },
        "parent_not_found": {
          "template": "Child parent not found in issues.",
          "context": {}
        }
      }
    },
    "GOV006": {
      "description": "parent_child_link_not_bidirectional",
      "severity": "error",
      "group": "parent_child_link",
      "messages": {
        "not_bidirectional": {
          "template": "Parent children array does not list this child.",
          "context": {}
        }
      }
    },
    "GOV007": {
      "description": "checked_parent_incomplete_child",
      "severity": "error",
      "group": "completion_consistency",
      "messages": {
        "checked_parent_open_child": {
          "template": "Parent item is checked but child is still open.",
          "context": {}
        },
        "checked_parent_incomplete_acceptance": {
          "template": "Parent item is checked but child has incomplete acceptance.",
          "context": {}
        }
      }
    },
    "GOV008": {
      "description": "closed_child_incomplete_acceptance",
      "severity": "error",
      "group": "completion_consistency",
      "messages": {
        "closed_incomplete_acceptance": {
          "template": "Closed child has unchecked acceptance criteria.",
          "context": {}
        }
      }
    },
    "GOV009": {
      "description": "closed_child_parent_unchecked_or_stale",
      "severity": "warning",
      "group": "completion_consistency",
      "messages": {
        "closed_unchecked_parent": {
          "template": "Closed child's parent item is not checked.",
          "context": {}
        }
      }
    },
    "GOV010": {
      "description": "missing_current_status",
      "severity": "error",
      "group": "required_sections",
      "messages": {
        "missing_current_status": {
          "template": "Missing Current status section.",
          "context": {}
        }
      }
    },
    "GOV011": {
      "description": "missing_reconciliation_timestamp",
      "severity": "error",
      "group": "required_sections",
      "messages": {
        "missing_timestamp": {
          "template": "Missing reconciliation timestamp.",
          "context": {}
        }
      }
    },
    "GOV012": {
      "description": "multiple_reconciliation_timestamps",
      "severity": "error",
      "group": "required_sections",
      "messages": {
        "multiple_timestamps": {
          "template": "Multiple reconciliation timestamps found ({count}).",
          "context": {
            "count": { "type": "integer", "minimum": 2, "maximum": 10000 }
          }
        }
      }
    },
    "GOV013": {
      "description": "malformed_reconciliation_timestamp",
      "severity": "warning",
      "group": "required_sections",
      "messages": {
        "malformed_timestamp": {
          "template": "Timestamp is present but malformed.",
          "context": {}
        },
        "impossible_date": {
          "template": "Timestamp contains an invalid date or time.",
          "context": {}
        }
      }
    },
    "GOV014": {
      "description": "missing_why_section",
      "severity": "error",
      "group": "required_sections",
      "messages": {
        "missing_why_section": {
          "template": "Missing \"Why this issue exists\" section.",
          "context": {}
        }
      }
    },
    "GOV015": {
      "description": "missing_required_tracking_dimensions",
      "severity": "error",
      "group": "required_sections",
      "messages": {
        "missing_dimension": {
          "template": "Missing required tracking dimension.",
          "context": {}
        }
      }
    },
    "GOV016": {
      "description": "missing_acceptance_criteria",
      "severity": "error",
      "group": "required_sections",
      "messages": {
        "missing_acceptance_criteria": {
          "template": "Missing Acceptance criteria section.",
          "context": {}
        }
      }
    },
    "GOV017": {
      "description": "superseded_no_reason_or_successor",
      "severity": "warning",
      "group": "superseded",
      "messages": {
        "no_reason_or_successor": {
          "template": "Issue is superseded/duplicate/not-planned but has no reason or successor.",
          "context": {}
        }
      }
    },
    "GOV018": {
      "description": "pr_merge_treated_as_completion",
      "severity": "error",
      "group": "anti_patterns",
      "messages": {
        "pr_merge_as_completion": {
          "template": "Issue body treats PR merge as sufficient completion.",
          "context": {}
        }
      }
    },
    "GOV019": {
      "description": "implementer_claims_independent_acceptance",
      "severity": "error",
      "group": "anti_patterns",
      "messages": {
        "implementer_self_acceptance": {
          "template": "Issue body contains implementer self-acceptance claim.",
          "context": {}
        }
      }
    },
    "GOV020": {
      "description": "policy_version_drift",
      "severity": "warning",
      "group": "policy_drift",
      "messages": {
        "policy_version_drift": {
          "template": "Snapshot policy version differs from canonical policy.",
          "context": {}
        }
      }
    },
    "GOV021": {
      "description": "unknown_governance_mode_requires_selection",
      "severity": "warning",
      "group": "governance_mode",
      "messages": {
        "unknown_governance_mode": {
          "template": "Governance mode is unknown. Repository must select a governance mode.",
          "context": {}
        }
      }
    },
    "GOV022": {
      "description": "multiple_active_implementation_prs",
      "severity": "error",
      "group": "implementation_pr",
      "messages": {
        "multiple_active_prs": {
          "template": "Issue has {count} active implementation PRs.",
          "context": {
            "count": { "type": "integer", "minimum": 2, "maximum": 10000 }
          }
        }
      }
    },
    "GOV023": {
      "description": "implementation_branch_body_metadata_disagree",
      "severity": "error",
      "group": "implementation_pr",
      "messages": {
        "branch_disagree": {
          "template": "Structured implementation branch disagrees with body.",
          "context": {}
        },
        "pr_disagree": {
          "template": "Implementation PR metadata disagrees with body.",
          "context": {}
        },
        "body_not_opened_but_pr_exists": {
          "template": "Body states Implementation PR: Not opened but PR record exists.",
          "context": {}
        },
        "body_pr_not_in_structured": {
          "template": "Body identifies an implementation PR but no matching structured record exists.",
          "context": {}
        },
        "missing_body_implementation_pr": {
          "template": "Implementation-work issue is missing required Implementation PR body metadata.",
          "context": {}
        }
      }
    },
    "GOV024": {
      "description": "replacement_pr_without_reason",
      "severity": "error",
      "group": "implementation_pr",
      "messages": {
        "no_replacement_reason": {
          "template": "Replacement PR has no recorded exceptional reason.",
          "context": {}
        },
        "no_supersedes_pr": {
          "template": "Replacement PR has no supersedes_pr.",
          "context": {}
        }
      }
    },
    "GOV025": {
      "description": "duplicate_issue_id",
      "severity": "error",
      "group": "identity",
      "messages": {
        "duplicate_identity": {
          "template": "Duplicate issue identity detected. Two or more issues resolve to the same canonical identifier.",
          "context": {}
        }
      }
    },
    "GOV026": {
      "description": "canonical_parent_not_found_or_not_parent",
      "severity": "error",
      "group": "parent_tracker",
      "messages": {
        "canonical_parent_not_found": {
          "template": "Declared canonical_parent_tracker identifier is absent, unresolved, targets a non-parent issue or contradicts the uniquely identified canonical parent.",
          "context": {}
        }
      }
    },
    "GOV027": {
      "description": "contradictory_derived_field",
      "severity": "error",
      "group": "body_authority",
      "messages": {
        "checklist_contradiction": {
          "template": "Structured checklist contradicts body.",
          "context": {}
        },
        "children_contradiction": {
          "template": "Structured children array contradicts body checklist.",
          "context": {}
        },
        "reconciliation_contradiction": {
          "template": "Structured reconciliation timestamp contradicts body.",
          "context": {}
        },
        "acceptance_contradiction": {
          "template": "Structured acceptance_criteria_met contradicts body.",
          "context": {}
        },
        "parent_contradiction": {
          "template": "Structured parent contradicts body Parent tracker line.",
          "context": {}
        },
        "replacement_contradiction": {
          "template": "Replacement metadata contradicts body or is structurally invalid.",
          "context": {}
        }
      }
    }
  },
  "exit_codes": { "0": "audit_no_violations", "1": "audit_violations_found", "2": "input_schema_or_execution_failure" }
}
