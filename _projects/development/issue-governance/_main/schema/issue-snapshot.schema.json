{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/weijunswj/ai-agent-toolkit/schemas/issue-snapshot.schema.json",
  "title": "Issue Governance Snapshot",
  "description": "Deterministic local snapshot of repository issue state for advisory audit.",
  "type": "object",
  "required": ["snapshot_version", "repository", "issues"],
  "additionalProperties": false,
  "properties": {
    "snapshot_version": { "type": "string", "const": "1.0.0" },
    "repository": { "$ref": "#/$defs/repository_metadata" },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue_record" } }
  },
  "$defs": {
    "repository_metadata": {
      "type": "object",
      "required": ["governance_mode"],
      "additionalProperties": false,
      "properties": {
        "fixture_id": { "type": "string" },
        "governance_mode": { "type": "string", "enum": ["toolkit_governed", "repository_native", "unknown"] },
        "canonical_parent_tracker": { "type": ["integer", "string"] },
        "policy_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "issue_record": {
      "type": "object",
      "required": ["id", "state", "category", "body"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": ["integer", "string"] },
        "state": { "type": "string", "enum": ["open", "closed"] },
        "category": { "type": "string", "enum": ["canonical_parent_tracker", "active_multi_step_child", "small_atomic_child", "recurring_evidence_log", "superseded_duplicate_not_planned", "complete"] },
        "body": { "type": "string", "minLength": 1 },
        "parent": { "type": ["integer", "string", "null"] },
        "children": { "type": "array", "items": { "type": ["integer", "string"] }, "uniqueItems": true },
        "linked_prs": { "type": "array", "items": { "type": "object", "required": ["number"], "additionalProperties": false, "properties": { "number": { "type": ["integer", "string"] }, "state": { "type": "string", "enum": ["open", "closed", "merged"] }, "merged": { "type": "boolean" } } } },
        "implementation_branch": { "type": ["string", "null"] },
        "implementation_prs": { "type": "array", "items": { "type": "object", "required": ["number", "state"], "additionalProperties": false, "properties": { "number": { "type": ["integer", "string"] }, "state": { "type": "string", "enum": ["open", "closed", "merged"] }, "is_replacement": { "type": "boolean" }, "replacement_reason": { "type": ["string", "null"] }, "supersedes_pr": { "type": ["integer", "string", "null"] } } } },
        "reconciliation_timestamp": { "type": ["string", "null"] },
        "acceptance_criteria_met": { "type": ["boolean", "null"] },
        "checklist_items": { "type": "array", "items": { "$ref": "#/$defs/checklist_item" } },
        "successor": { "type": ["integer", "string", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "checklist_item": {
      "type": "object",
      "required": ["checked", "text"],
      "additionalProperties": false,
      "properties": {
        "checked": { "type": "boolean" },
        "text": { "type": "string" },
        "linked_issue": { "type": ["integer", "string", "null"] }
      }
    }
  }
}
