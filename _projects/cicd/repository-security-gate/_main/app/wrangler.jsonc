{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weijunswj-toolkit-security-gate",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RUN_STATE",
        "class_name": "GateRunState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GateRunState"
      ]
    }
  ]
}
