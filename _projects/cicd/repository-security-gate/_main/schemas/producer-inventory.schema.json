{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tk.security.required-check-producer-inventory/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "candidate_head",
    "candidate_tree",
    "authority_commit",
    "authority_tree",
    "workflow_files",
    "jobs",
    "edges",
    "produced_names",
    "required_contexts",
    "case_ambiguities",
    "producer_records",
    "files",
    "inventory_digest",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "tk.security.required-check-producer-inventory/v1"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "maxLength": 200
    },
    "candidate_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "authority_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "authority_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "workflow_files": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "jobs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "edges": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "produced_names": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "required_contexts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "publisher_declarations",
          "terminal_jobs",
          "github_actions_name_collisions"
        ],
        "properties": {
          "id": {
            "enum": [
              "repository-security-gate",
              "validate",
              "validate-toolkit"
            ]
          },
          "name": {
            "enum": [
              "Repository security gate",
              "Validate",
              "Validate Toolkit"
            ]
          },
          "publisher_declarations": {
            "const": 1
          },
          "terminal_jobs": {
            "const": 1
          },
          "github_actions_name_collisions": {
            "const": 0
          }
        }
      }
    },
    "case_ambiguities": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ambiguity_key",
          "exact_names"
        ],
        "properties": {
          "ambiguity_key": {
            "type": "string",
            "maxLength": 256
          },
          "exact_names": {
            "type": "array",
            "minItems": 2,
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 256
            }
          }
        }
      }
    },
    "producer_records": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "workflow",
          "events",
          "job_id",
          "exact_names",
          "ambiguity_keys",
          "needs",
          "job_if",
          "continue_on_error",
          "timeout_minutes",
          "matrix_expansions",
          "reusable_workflow",
          "step_uses",
          "step_conditions",
          "step_continue_on_error"
        ],
        "properties": {
          "role": { "enum": ["authority", "candidate"] },
          "workflow": { "type": "string", "maxLength": 500 },
          "events": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 100 } },
          "job_id": { "type": "string", "pattern": "^[a-z0-9-]{1,80}$" },
          "exact_names": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "maxLength": 256 } },
          "ambiguity_keys": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "maxLength": 256 } },
          "needs": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 80 } },
          "job_if": { "type": ["string", "null"], "maxLength": 500 },
          "continue_on_error": { "type": "boolean" },
          "timeout_minutes": { "type": ["integer", "null"], "minimum": 1, "maximum": 360 },
          "matrix_expansions": { "type": "integer", "minimum": 1, "maximum": 64 },
          "reusable_workflow": { "type": ["string", "null"], "maxLength": 500 },
          "step_uses": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 500 } }
          ,
          "step_conditions": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 500 } },
          "step_continue_on_error": { "type": "boolean" }
        }
      }
    },
    "files": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "blob",
          "sha256",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 500
          },
          "blob": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "workflow",
              "local-action",
              "app-authority"
            ]
          }
        }
      }
    },
    "inventory_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "PASS",
        "UNVERIFIED"
      ]
    }
  }
}
