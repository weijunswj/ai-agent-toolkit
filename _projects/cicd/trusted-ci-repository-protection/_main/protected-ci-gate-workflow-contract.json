{
  "contract_version": "toolkit.n6.protected-ci-gate-workflow.v1",
  "workflow_id": "n6-protected-ci-gate",
  "workflow_name": "CI Gate",
  "base_ref": "refs/heads/main",
  "allowed_triggers": ["pull_request_target", "merge_group"],
  "forbidden_triggers": ["pull_request", "push", "workflow_dispatch", "workflow_run", "workflow_call", "schedule", "issue_comment", "repository_dispatch"],
  "candidate_code_execution": false,
  "permissions": {
    "contents": "read",
    "actions": "read",
    "checks": "read"
  },
  "publisher": {
    "protocol_version": "toolkit.n6.app-publisher.v1",
    "context": "CI Gate"
  },
  "actions": ["actions/checkout@v4"],
  "checkout": {
    "ref": "github.event.repository.default_branch",
    "persist_credentials": false,
    "candidate_head_checkout": false
  },
  "composition_input": {
    "transport": "json-stdin",
    "source": "protected-runner-temp",
    "path": "$RUNNER_TEMP/n6-protected-ci-input.json",
    "candidate_owned": false,
    "max_bytes": 4194304,
    "required_fields": ["repository_id", "pr", "head_sha", "base_sha", "merge_sha", "changed_paths", "component_results", "evidence", "evidence_archive", "non_ci_evidence"]
  },
  "required_steps": ["validate-protected-workflow", "git-diff-check", "validate-trusted-ci-composition"],
  "secrets": false,
  "statuses": false
}
