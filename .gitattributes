# Auto detect text files and perform LF normalization
* text=auto

# Exact source-locked helper copies preserve upstream source bytes too.
skills/n8n-workflow-helper-scripts/templates/helper-scripts/sanitizer/*.cmd -text whitespace=cr-at-eol
skills/n8n-workflow-helper-scripts/templates/helper-scripts/sanitizer/*.js -text whitespace=cr-at-eol
skills/n8n-workflow-helper-scripts/templates/helper-scripts/sanitizer/*.ps1 -text whitespace=cr-at-eol
skills/n8n-workflow-helper-scripts/templates/helper-scripts/import-export-sync/*.cmd -text whitespace=cr-at-eol
skills/n8n-workflow-helper-scripts/templates/helper-scripts/import-export-sync/*.cjs -text whitespace=cr-at-eol
skills/n8n-workflow-helper-scripts/templates/helper-scripts/import-export-sync/*.ps1 -text whitespace=cr-at-eol

# Generated CI workflow templates are compared byte-for-byte by sync checks.
skills/context-preserving-ai-publisher/templates/ci/*.yml text eol=lf
repo/contracts/trusted-ci-repository-protection/templates/protected-ci-gate.workflow.yml text eol=lf

# Canonical byte-for-byte text copies must stay platform-stable across checkouts.
/README.md text eol=lf
.codex-plugin/** text eol=lf
.codex-plugin/**/*.png binary
.claude-plugin/** text eol=lf
skills/ai-coding-agent-rules/**/*.md text eol=lf
skills/n8n-local-setup/** text eol=lf
skills/n8n-agent-rules/scripts/install-n8n-agent-adapter.cjs text eol=lf
skills/toolkit-setup/** text eol=lf
skills/windows-localhost-workflows/agents/openai.yaml text eol=lf
skills/**/*.yaml text eol=lf
skills/**/*.yml text eol=lf
skills/**/*.sh text eol=lf
skills/**/*.env.example text eol=lf
repo/tests/fixtures/n8n-skills-1.0.1/** text eol=lf

# Design skill Markdown is validated as LF-only.
skills/ui-ux-secure-frontend-design/**/*.md text eol=lf

# Promoted UI/UX skill text copies must stay platform-stable across checkouts.
skills/ui-ux-secure-frontend-design/agents/openai.yaml text eol=lf
skills/ui-ux-secure-frontend-design/tools/design-system-generator/tests/test_local_only.py text eol=lf

# Generated byte-for-byte design tool outputs must stay platform-stable.
skills/ui-ux-secure-frontend-design/tools/design-system-generator/data/** -text whitespace=cr-at-eol
skills/ui-ux-secure-frontend-design/tools/design-system-generator/scripts/core.py -text
skills/ui-ux-secure-frontend-design/tools/design-system-generator/scripts/design_system.py -text
