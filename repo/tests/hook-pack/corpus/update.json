    {
      "id": "U3",
      "source": "stale hooks after update plan",
      "kind": "benign",
      "hosts": ["codex"],
      "shells": ["powershell", "cmd", "sh"],
      "payload": { "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": { "command": "git status" } },
      "fixture": { "version_folder": "stand-in" },
