{
  "family": "update",
  "about": "A chat that was open while Toolkit updated itself: the version folder its hook commands name is replaced. fixture.version_folder is 'stand-in' (setup left the refusing stand-in) or 'missing' (the folder is gone). expect.exit is the hook's exit code as the host sees it: 2 refuses, 1 runs the call with a hook notice, 0 passes.",
  "rows": [
    {
      "id": "U1",
      "source": "stale hooks after update plan; Codex deletes older version folders on plugin install",
      "kind": "update",
      "hosts": ["codex"],
      "shells": ["powershell", "cmd", "sh"],
      "payload": { "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": { "command": "git push origin HEAD" } },
      "fixture": { "version_folder": "stand-in" },
      "expect": { "decision": "deny", "exit": 2, "reason": "superseded" },
      "status": "pass"
    },
    {
      "id": "U1-no-stand-in",
      "source": "stale hooks after update plan, step 1",
      "kind": "update",
      "hosts": ["codex"],
      "shells": ["powershell", "sh"],
      "payload": { "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": { "command": "git push origin HEAD" } },
      "fixture": { "version_folder": "missing" },
      "expect": { "decision": "deny", "exit": 2, "reason": "launcher-missing" },
      "status": "pass"
    },
    {
      "id": "U1-commit",
      "source": "stale hooks after update plan",
      "kind": "update",
      "hosts": ["codex"],
      "shells": ["powershell", "cmd", "sh"],
      "payload": { "hook_event_name": "PreToolUse", "tool_name": "exec_command", "tool_input": { "cmd": "git commit -m update" } },
      "fixture": { "version_folder": "stand-in" },
      "expect": { "decision": "deny", "exit": 2, "reason": "superseded" },
      "status": "pass"
    },
    {
      "id": "U1-merge",
      "source": "stale hooks after update plan",
      "kind": "update",
      "hosts": ["codex"],
      "shells": ["powershell", "cmd", "sh"],
      "payload": { "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": { "command": "gh pr merge 5 --merge" } },
      "fixture": { "version_folder": "stand-in" },
      "expect": { "decision": "deny", "exit": 2, "reason": "superseded" },
      "status": "pass"
    },
    {
