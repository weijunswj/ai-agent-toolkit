      "expect": { "decision": "deny", "exit": 2, "reason": "launcher-missing" },
      "status": "known-bad",
      "known_bad": { "lane": "Stop hooks failing open after update", "added": "2026-10-30", "note": "Claude Code keeps replaced version folders and runs Toolkit in place, so this is not reached by an update; a missing attribution hook script still fails open. Follow-up: the stable entry script from the pack plan." }
    },
    {
      "id": "U4",
