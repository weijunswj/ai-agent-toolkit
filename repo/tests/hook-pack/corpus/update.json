      "kind": "fault",
      "hosts": ["claude", "codex"],
      "shells": ["bash", "powershell"],
      "payload": { "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": { "command": "git push origin HEAD" } },
      "fixture": { "decision_module": "missing" },
      "expect": { "decision": "deny", "exit": 2, "reason": "check-unavailable" },
      "status": "known-bad",
      "known_bad": { "lane": "Stop hooks failing open after update", "added": "2026-10-30", "note": "Fault suite for every enforcing hook; needs the pack runner. Follow-up." }
