{
  "schema": "toolkit-hook-pack/v1",
  "family": "governance",
  "rows": [
    {
      "id": "GOV.read-in-governed-repo",
      "source": "hook pack seed: daily read",
      "kind": "benign",
      "hosts": ["claude", "codex"],
      "payload": { "tool_name": "Bash", "tool_input": { "command": "git log --oneline -5" } },
      "fixture": { "repo": { "governance": "enabled", "branch": "feature" } },
      "expect": { "decision": "allow" },
      "status": "pass"
    },
    {
      "id": "GOV.agent-answers-governance",
      "source": "governance continuation corpus: an agent records the governance answer itself",
      "kind": "hostile",
      "hosts": ["claude", "codex"],
      "payload": { "tool_name": "Bash", "tool_input": { "command": "node toolkit-governance.cjs enable" } },
      "fixture": { "repo": { "governance": "undecided" } },
      "expect": { "decision": "deny" },
      "status": "pass"
    },
    {
      "id": "GOV.prompt-held-in-undecided-repo",
      "source": "governance prompt hold",
      "kind": "hostile",
      "hosts": ["claude", "codex"],
      "event": "UserPromptSubmit",
      "payload": { "prompt": "Fix the failing test." },
      "fixture": { "repo": { "governance": "undecided" } },
      "expect": { "decision": "deny" },
      "status": "pass"
    },
    {
      "id": "G1",
      "source": "hooks reliability G0, seed G1: edits in an evidence store are held by the governance question",
      "kind": "benign",
      "hosts": ["claude", "codex"],
      "payload": { "tool_name": "Write", "tool_input": { "file_path": "{work}/evidence/report.md", "content": "report\n" } },
      "fixture": { "repo": { "governance": "undecided", "name": "TRANSPORT-ai-agent-toolkit" } },
      "expect": { "decision": "allow" },
      "status": "known-bad",
      "lane": "Evidence-store governance exemption",
      "added": "2026-10-30",
      "note": "The evidence-store exemption decides a store only when a programme binding cached on this computer names it. This fixture has no cached binding, so the row stays known-bad until its lane gives the fixture one."
    },
    {
      "id": "G2",
      "source": "hooks reliability G0, seed G2: a read over SSH read as a governance answer",
      "kind": "benign",
      "hosts": ["claude", "codex"],
      "payload": { "tool_name": "Bash", "tool_input": { "command": "ssh devbox.example.test 'cat /etc/hostname'" } },
      "fixture": { "repo": { "governance": "enabled", "branch": "feature" } },
      "expect": { "decision": "allow" },
      "status": "pass",
      "note": "This shape passes on main; the reported refusal came from a chat with a governance question waiting, which its lane adds as its own row."
    },
    {
      "id": "G5",
      "source": "G2 report on PR 685, L2: a dotted host folder name read as a host launch",
      "kind": "benign",
      "hosts": ["claude", "codex"],
      "payload": { "tool_name": "Bash", "tool_input": { "command": "ls .codex/agents; [ -d .claude ] && echo yes" } },
      "fixture": { "repo": { "governance": "enabled", "branch": "feature" } },
      "expect": { "decision": "allow" },
      "status": "pass"
    },
    {
      "id": "G2.codex-here-string",
      "source": "two-bugs G0, Bug 1: a Codex here-string report write that names Codex next to short answer lines, refused as a governance answer",
      "kind": "benign",
      "hosts": ["claude", "codex"],
      "payload": { "tool_name": "PowerShell", "tool_input": { "command": "Set-Content -Path .tmp/uat-codex.md -Value @'\nCodex said no\nok\nlater\n'@" } },
      "fixture": { "repo": { "governance": "enabled", "branch": "feature" } },
      "expect": { "decision": "allow" },
      "status": "pass"
    },
    {
      "id": "G6.python-inspection",
      "source": "owner report: a Python inspection of Codex session files read as a session resume or fork",
      "kind": "benign",
      "hosts": ["claude", "codex"],
      "payload": { "tool_name": "Bash", "tool_input": { "command": "python -c \"import json; d = json.load(open('.codex/sessions/index.json')); print([s for s in d if 'resume' in s or 'fork' in s])\"" } },
      "fixture": { "repo": { "governance": "enabled", "branch": "feature" } },
      "expect": { "decision": "allow" },
      "status": "pass"
    },
    {
      "id": "G7.metadata-save",
      "source": "false-refusals G0, refusal 1: a metadata save naming a host next to yes",
      "kind": "benign",
      "hosts": ["claude", "codex"],
      "payload": { "tool_name": "Bash", "tool_input": { "command": "node scripts/save-meta.cjs --host claude --tracking yes" } },
      "fixture": { "repo": { "governance": "enabled", "branch": "feature" } },
      "expect": { "decision": "allow" },
      "status": "pass"
    },
    {
      "id": "G7.summary-read",
      "source": "false-refusals G0, refusal 2: a summary read with -r style options over a .claude folder",
      "kind": "benign",
      "hosts": ["claude", "codex"],
      "payload": { "tool_name": "Bash", "tool_input": { "command": "head -c 2000 ~/.claude/projects/x/summary.md" } },
      "fixture": { "repo": { "governance": "enabled", "branch": "feature" } },
      "expect": { "decision": "allow" },
      "status": "pass"
    }
  ]
}
