    {
      "id": "MERGE.codex-resume-typed-fresh-chat",
      "source": "resumed or revoked chat records no typed approval; a fresh chat on the same computer grants one",
      "kind": "state",
      "hosts": ["codex"],
      "steps": [
        {"event":"SessionStart","payload":{"source":"startup"},"expect":{"decision":"allow"}},
        {"event":"SessionStart","payload":{"source":"resume"},"expect":{"decision":"allow"}},
        {"event":"UserPromptSubmit","payload":{"prompt":"merge 5"},"expect":{"decision":"allow"}},
        {"payload":{"tool_name":"Bash","tool_input":{"command":"gh pr merge 5 --merge --match-head-commit {head}"}},"expect":{"decision":"deny"}},
        {"event":"SessionStart","payload":{"source":"startup","session_id":"fresh-approval"},"expect":{"decision":"allow"}},
        {"event":"UserPromptSubmit","payload":{"prompt":"merge 5","session_id":"fresh-approval"},"expect":{"decision":"allow"}}
      ],
      "payload": {"tool_name":"Bash","tool_input":{"command":"gh pr merge 5 --merge --match-head-commit {head}"}},
      "fixture": {"repo":{"governance":"enabled","branch":"feature","task_auto_merge":"after-gates","commits":[{"files":{"README.md":"fixture\n"},"message":"base"},{"files":{"notes.md":"task change\n"},"message":"task change"}]}},
      "expect": {"decision":"allow"},
      "status": "pass"
    },
