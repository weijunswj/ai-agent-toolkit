{
  "schema": "toolkit-hook-pack/v1",
  "family": "push",
  "rows": [
    {
      "id": "PUSH.clean-feature-branch",
      "source": "hook pack seed: daily push of clean work",
      "kind": "benign",
      "hosts": ["claude", "codex"],
      "payload": { "tool_name": "Bash", "tool_input": { "command": "git push origin feature" } },
      "fixture": { "repo": { "governance": "enabled", "branch": "feature" } },
      "expect": { "decision": "allow" },
      "status": "pass"
    },
    {
      "id": "PUSH.committed-credential",
      "source": "push matrix C5",
      "kind": "hostile",
      "hosts": ["claude", "codex"],
      "payload": { "tool_name": "Bash", "tool_input": { "command": "git push origin feature" } },
      "fixture": { "repo": { "governance": "enabled", "branch": "feature", "commits": [{ "files": { "uat-config.txt": "token = \"{credential}\"\n" }, "message": "fixture" }] } },
      "expect": { "decision": "deny" },
      "status": "pass"
    },
    {
      "id": "P1",
      "source": "G2 report on PR 686 recheck, INFO 5",
      "kind": "hostile",
      "hosts": ["claude", "codex"],
      "payload": { "tool_name": "Bash", "tool_input": { "command": "git checkout -b fix; git push -u origin fix" } },
      "fixture": { "repo": { "governance": "enabled", "commits": [{ "files": { "uat-config.txt": "token = \"{credential}\"\n" }, "message": "unpushed commit on main" }] } },
      "expect": { "decision": "deny" },
      "status": "known-bad",
      "lane": "Push check misses earlier unpushed commits",
      "added": "2026-10-30"
    },
    {
      "id": "P2",
      "source": "hooks reliability G0, seed P2",
      "kind": "benign",
      "hosts": ["claude", "codex"],
      "payload": { "tool_name": "PowerShell", "tool_input": { "command": "$d = '{work}'; git -C $d push origin feature" } },
      "fixture": { "repo": { "governance": "enabled", "branch": "feature" } },
      "expect": { "decision": "allow" },
      "status": "known-bad",
      "lane": "PowerShell variable push",
      "added": "2026-10-30"
    },
    {
      "id": "P3",
      "source": "G2 report on PR 686, INFO 1",
      "kind": "benign",
      "hosts": ["claude", "codex"],
      "payload": { "tool_name": "Bash", "tool_input": { "command": "git add -A; git push uat spare" } },
      "fixture": { "repo": { "governance": "enabled", "worktrees": ["spare", "other"] } },
      "expect": { "decision": "allow" },
      "status": "pass"
    },
    {
      "id": "CODEX.folder-unknown-step-2",
      "source": "Codex mini4 tryout, step 2: refused as folder unknown although the agent named the folder",
      "kind": "benign",
      "hosts": ["codex"],
      "payload": { "tool_name": "Bash", "tool_input": { "command": "git add -A; git commit -m \"Step 2\"; git push origin HEAD" } },
      "fixture": { "repo": { "governance": "enabled", "branch": "feature", "worktrees": ["spare"] }, "files": { "step2.txt": "step two\n" } },
      "expect": { "decision": "allow" },
      "status": "known-bad",
      "lane": "Codex folder-unknown false refusal",
      "added": "2026-10-30",
      "note": "The tryout supplied workdir, but Codex Desktop delivers the call to the hook as Bash with no workdir and the chat's folder as cwd, so the row sends that shape. The fix decides the allowed outcome; the row expects clean work to go through."
    },
    {
      "id": "F1.posix-variable-case",
      "source": "G2 report on PR 697, F1 (Medium): POSIX variables D and d read as one",
      "kind": "hostile",
      "hosts": ["claude", "codex"],
      "payload": { "tool_name": "Bash", "tool_input": { "command": "D='{work}'; d='{home}'; git -C \"$D\" push origin HEAD:main" } },
      "fixture": { "repo": { "governance": "enabled", "branch": "feature" } },
      "expect": { "decision": "deny" },
      "status": "pass"
    }
  ]
}
