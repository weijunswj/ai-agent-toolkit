{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.route-resolution.host-capability-proof.v1",
  "title": "Toolkit host capability proof",
  "description": "Capability evidence for an already resolved launch. It cannot select or substitute a route.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "proof_id", "host", "adapter_id", "launch_record_digest", "provider", "model", "reasoning", "service_tier", "speed", "status", "trusted", "metadata_verified"],
  "properties": {
    "contract_version": { "const": "toolkit.route-resolution.host-capability-proof.v1" },
    "proof_id": { "type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._:/-]{1,128}$" },
    "host": { "enum": ["codex", "claude-code", "opencode"] },
    "adapter_id": { "type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._:/-]{1,128}$" },
    "launch_record_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provider": { "const": "openai" },
    "model": { "type": "string", "enum": ["gpt-6-astra", "gpt-5.6-sol", "gpt-5.6-luna"] },
    "reasoning": { "type": "string", "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] },
    "service_tier": { "const": "standard" },
    "speed": { "enum": ["standard", "priority"] },
    "status": { "enum": ["available", "unsupported", "contradictory"] },
    "trusted": { "type": "boolean" },
    "metadata_verified": { "type": "boolean" }
  }
}
