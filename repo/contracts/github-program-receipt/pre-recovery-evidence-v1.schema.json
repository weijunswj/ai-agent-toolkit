{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.github-program.pre-recovery-evidence.v1",
  "title": "Toolkit GitHub Programme Pre-Recovery Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "repository",
    "parent_issue",
    "child_issue",
    "lock",
    "namespace_digest",
    "old_allocation_id",
    "old_run_id",
    "old_allocation_digest",
    "old_run_digest",
    "old_lease_id",
    "old_fence_id",
    "old_fence_sequence",
    "old_lease_issued_at",
    "old_lease_expires_at",
    "old_lease_tip_event_id",
    "old_lease_tip_event_digest",
    "old_receipt_tip_id",
    "old_receipt_tip_sequence",
    "old_receipt_tip_digest",
    "old_receipt_chain_digest",
    "zero_operation_count",
    "zero_operation_event_count",
    "zero_operation_inventory_digest",
    "authority_digest",
    "source_digest",
    "start_digest",
    "old_holder_classification",
    "old_holder_identity_digest",
    "old_holder_attestation_digest",
    "recovery_peer_platform",
    "recovery_peer_identity_digest",
    "recovery_peer_process_incarnation_digest",
    "broker_identity_digest",
    "broker_key_id",
    "observed_at",
    "authority_observed_at",
    "source_observed_at",
    "start_observed_at",
    "store_observed_at",
    "holder_observed_at"
  ],
  "properties": {
    "schema": { "const": "toolkit.github-program.pre-recovery-evidence.v1" },
    "request_id": { "$ref": "#/$defs/id" },
    "repository": { "$ref": "#/$defs/repository" },
    "parent_issue": { "type": "integer", "minimum": 1 },
    "child_issue": { "type": "integer", "minimum": 1 },
    "lock": { "$ref": "#/$defs/id" },
    "namespace_digest": { "$ref": "#/$defs/digest" },
    "old_allocation_id": { "$ref": "#/$defs/id" },
    "old_run_id": { "$ref": "#/$defs/id" },
    "old_allocation_digest": { "$ref": "#/$defs/digest" },
    "old_run_digest": { "$ref": "#/$defs/digest" },
    "old_lease_id": { "$ref": "#/$defs/id" },
    "old_fence_id": { "$ref": "#/$defs/id" },
    "old_fence_sequence": { "type": "integer", "minimum": 1 },
    "old_lease_issued_at": { "$ref": "#/$defs/timestamp" },
    "old_lease_expires_at": { "$ref": "#/$defs/timestamp" },
    "old_lease_tip_event_id": { "$ref": "#/$defs/id" },
    "old_lease_tip_event_digest": { "$ref": "#/$defs/digest" },
    "old_receipt_tip_id": { "$ref": "#/$defs/digest" },
    "old_receipt_tip_sequence": { "type": "integer", "minimum": 1 },
    "old_receipt_tip_digest": { "$ref": "#/$defs/digest" },
    "old_receipt_chain_digest": { "$ref": "#/$defs/digest" },
    "zero_operation_count": { "const": 0 },
    "zero_operation_event_count": { "const": 0 },
    "zero_operation_inventory_digest": { "$ref": "#/$defs/digest" },
    "authority_digest": { "$ref": "#/$defs/digest" },
    "source_digest": { "$ref": "#/$defs/digest" },
    "start_digest": { "$ref": "#/$defs/digest" },
    "old_holder_classification": { "const": "ORPHAN_NONADOPTABLE" },
    "old_holder_identity_digest": { "$ref": "#/$defs/digest" },
    "old_holder_attestation_digest": { "$ref": "#/$defs/digest" },
    "recovery_peer_platform": { "enum": ["windows", "linux"] },
    "recovery_peer_identity_digest": { "$ref": "#/$defs/digest" },
    "recovery_peer_process_incarnation_digest": { "$ref": "#/$defs/digest" },
    "broker_identity_digest": { "$ref": "#/$defs/digest" },
    "broker_key_id": { "$ref": "#/$defs/id" },
    "observed_at": { "$ref": "#/$defs/timestamp" },
    "authority_observed_at": { "$ref": "#/$defs/timestamp" },
    "source_observed_at": { "$ref": "#/$defs/timestamp" },
    "start_observed_at": { "$ref": "#/$defs/timestamp" },
    "store_observed_at": { "$ref": "#/$defs/timestamp" },
    "holder_observed_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]{1,100}/[a-z0-9_.-]{1,100}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 32
    }
  }
}
