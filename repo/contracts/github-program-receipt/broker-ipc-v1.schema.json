{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.github-program.broker-ipc.v1",
  "title": "Toolkit GitHub Programme Broker IPC v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "operation", "namespace", "lock", "expected"],
  "properties": {
    "schema": { "const": "toolkit.github-program.broker-ipc.v1" },
    "request_id": { "$ref": "#/$defs/request_id" },
    "operation": { "$ref": "#/$defs/operation" },
    "namespace": { "$ref": "#/$defs/namespace" },
    "lock": { "$ref": "#/$defs/id" },
    "expected": { "$ref": "#/$defs/expected" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "minLength": 24,
      "maxLength": 24
    },
    "safe_git_ref": {
      "type": "string",
      "pattern": "^(?!@$)(?!-)(?!/)(?!.*(?:\\.\\.|@\\{|//|[\\u0000-\\u0020\\u007f~^:?*\\[\\\\]))(?!.*(?:^|/)\\.)(?!.*\\.lock(?:/|$))(?!.*[/.]$).{1,240}$"
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "parent_issue", "child_issue"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]{1,100}/[a-z0-9_.-]{1,100}$"
        },
        "parent_issue": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "child_issue": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_digest"],
      "properties": {
        "state_digest": {
          "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        }
      }
    },
    "authority": {
      "$ref": "run-receipt-v1.schema.json#/$defs/authority"
    },
    "start": {
      "$ref": "run-receipt-v1.schema.json#/$defs/start"
    },
    "candidate": {
      "$ref": "run-receipt-v1.schema.json#/$defs/candidate"
    },
    "lease": {
      "$ref": "run-receipt-v1.schema.json#/$defs/lease"
    },
    "payload": {
      "$ref": "run-receipt-v1.schema.json#/$defs/payload"
    },
    "receipt": {
      "$ref": "run-receipt-v1.schema.json#"
    },
    "receipt_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_type", "candidate", "payload", "created_at"],
      "properties": {
        "receipt_type": {
          "enum": ["TRANSITION_PREVIEW", "EXECUTOR_TERMINAL", "G4_TERMINAL", "RUN_INTERRUPTED"]
        },
        "candidate": {
          "anyOf": [{ "$ref": "#/$defs/candidate" }, { "type": "null" }]
        },
        "payload": { "$ref": "#/$defs/payload" },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "target_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_type", "resource_id"],
      "properties": {
        "resource_type": {
          "type": "string",
          "pattern": "^(?!-)(?!.*\\.\\.)[A-Za-z0-9._:/-]{1,80}$"
        },
        "resource_id": {
          "type": "string",
          "pattern": "^(?!-)(?!.*\\.\\.)[A-Za-z0-9._:/-]{1,512}$"
        }
      }
    },
    "operation_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_kind",
        "safety_class",
        "target_identity",
        "target_digest",
        "expected_source_digest",
        "cas_digest",
        "expected_post_state_digest",
        "adapter_identity_digest",
        "retry_of_operation_id"
      ],
      "properties": {
        "operation_kind": {
          "enum": ["GIT_REF_UPDATE", "CONDITIONAL_PROVIDER_UPDATE", "IDEMPOTENT_SET", "APPEND_CREATE"]
        },
        "safety_class": {
          "enum": ["CAS", "IDEMPOTENT", "APPEND_IDEMPOTENT"]
        },
        "target_identity": { "$ref": "#/$defs/target_identity" },
        "target_digest": { "$ref": "#/$defs/digest" },
        "expected_source_digest": { "$ref": "#/$defs/digest" },
        "cas_digest": { "$ref": "#/$defs/digest" },
        "expected_post_state_digest": {
          "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "adapter_identity_digest": { "$ref": "#/$defs/digest" },
        "retry_of_operation_id": {
          "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        }
      }
    },
    "outcome_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "logical_operation_digest",
        "adapter_identity_digest",
        "target_identity",
        "target_digest",
        "provider_operation_key",
        "cas_digest",
        "classification",
        "observed_post_state_digest",
        "rejection_digest",
        "delayed_completion_excluded",
        "evidence_at",
        "evidence_digest"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/id" },
        "logical_operation_digest": { "$ref": "#/$defs/digest" },
        "adapter_identity_digest": { "$ref": "#/$defs/digest" },
        "target_identity": { "$ref": "#/$defs/target_identity" },
        "target_digest": { "$ref": "#/$defs/digest" },
        "provider_operation_key": { "$ref": "#/$defs/id" },
        "cas_digest": { "$ref": "#/$defs/digest" },
        "classification": { "enum": ["APPLIED", "NOT_APPLIED", "UNKNOWN"] },
        "observed_post_state_digest": {
          "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "rejection_digest": {
          "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "delayed_completion_excluded": { "type": "boolean" },
        "evidence_at": { "$ref": "#/$defs/timestamp" },
        "evidence_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "READBACK_INSPECTION" },
            "target": { "enum": ["NAMESPACE", "RUN", "RECEIPT_CHAIN", "MUTATION", "RECOVERY"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "authority", "start", "candidate", "lease_ms"],
          "properties": {
            "kind": { "const": "ALLOCATE_RUN" },
            "authority": { "$ref": "#/$defs/authority" },
            "start": { "$ref": "#/$defs/start" },
            "candidate": { "type": "null" },
            "lease_ms": { "type": "integer", "minimum": 1000, "maximum": 86400000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "allocation_id"],
          "properties": {
            "kind": { "const": "START_RUN" },
            "allocation_id": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "receipt"],
          "properties": {
            "kind": { "const": "APPEND_RECEIPT" },
            "receipt": { "$ref": "#/$defs/receipt_input" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "INTERRUPT_RUN" },
            "reason": { "enum": ["REQUESTED", "BROKER_RECOVERY", "SHUTDOWN"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "descriptor"],
          "properties": {
            "kind": { "const": "MUTATION_ADMIT" },
            "descriptor": { "$ref": "#/$defs/operation_descriptor" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operation_id"],
          "properties": {
            "kind": { "const": "MUTATION_DISPATCH" },
            "operation_id": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operation_id", "evidence"],
          "properties": {
            "kind": { "const": "MUTATION_OUTCOME" },
            "operation_id": { "$ref": "#/$defs/id" },
            "evidence": { "$ref": "#/$defs/outcome_evidence" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operation_id"],
          "properties": {
            "kind": { "const": "MUTATION_RECONCILE" },
            "operation_id": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "old_run_digest", "evidence_digest"],
          "properties": {
            "kind": { "const": "ORPHAN_RECOVERY" },
            "old_run_digest": { "$ref": "#/$defs/digest" },
            "evidence_digest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source_schema_fingerprint"],
          "properties": {
            "kind": { "const": "MIGRATE_V2_TO_V3" },
            "source_schema_fingerprint": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "run_allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allocation_id", "run_id", "lock", "lease"],
      "properties": {
        "allocation_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "lock": { "$ref": "#/$defs/id" },
        "lease": { "$ref": "#/$defs/lease" }
      }
    },
    "mutation_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "logical_operation_digest",
        "run_id",
        "allocation_id",
        "lock",
        "authority_digest",
        "lease_id",
        "fence_id",
        "fence_sequence",
        "operation_kind",
        "safety_class",
        "target_identity",
        "target_digest",
        "expected_source_digest",
        "cas_digest",
        "expected_post_state_digest",
        "provider_operation_key",
        "adapter_identity_digest",
        "retry_of_operation_id",
        "created_at",
        "operation_digest"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/id" },
        "logical_operation_digest": { "$ref": "#/$defs/digest" },
        "run_id": { "$ref": "#/$defs/id" },
        "allocation_id": { "$ref": "#/$defs/id" },
        "lock": { "$ref": "#/$defs/id" },
        "authority_digest": { "$ref": "#/$defs/digest" },
        "lease_id": { "$ref": "#/$defs/id" },
        "fence_id": { "$ref": "#/$defs/id" },
        "fence_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "operation_kind": {
          "enum": ["GIT_REF_UPDATE", "CONDITIONAL_PROVIDER_UPDATE", "IDEMPOTENT_SET", "APPEND_CREATE"]
        },
        "safety_class": { "enum": ["CAS", "IDEMPOTENT", "APPEND_IDEMPOTENT"] },
        "target_identity": { "$ref": "#/$defs/target_identity" },
        "target_digest": { "$ref": "#/$defs/digest" },
        "expected_source_digest": { "$ref": "#/$defs/digest" },
        "cas_digest": { "$ref": "#/$defs/digest" },
        "expected_post_state_digest": {
          "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "provider_operation_key": { "$ref": "#/$defs/id" },
        "adapter_identity_digest": { "$ref": "#/$defs/digest" },
        "retry_of_operation_id": {
          "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "operation_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "mutation_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "operation_id",
        "sequence",
        "prior_event_id",
        "event_type",
        "state",
        "event_at",
        "authority_digest",
        "provider_evidence_digest",
        "readback_digest",
        "detail_digest",
        "event_digest"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/id" },
        "operation_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 50000 },
        "prior_event_id": {
          "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "event_type": { "type": "string", "pattern": "^[A-Z0-9_]{1,160}$" },
        "state": { "enum": ["PREPARED", "IN_FLIGHT", "APPLIED", "NOT_APPLIED", "UNKNOWN"] },
        "event_at": { "$ref": "#/$defs/timestamp" },
        "authority_digest": { "$ref": "#/$defs/digest" },
        "provider_evidence_digest": { "$ref": "#/$defs/digest" },
        "readback_digest": {
          "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "detail_digest": { "$ref": "#/$defs/digest" },
        "event_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "readback": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "namespace", "namespace_digest"],
          "properties": {
            "kind": { "const": "NAMESPACE" },
            "namespace": { "$ref": "#/$defs/namespace" },
            "namespace_digest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "allocation", "started", "run_started_receipt_id"],
          "properties": {
            "kind": { "const": "RUN" },
            "allocation": { "$ref": "#/$defs/run_allocation" },
            "started": { "type": "boolean" },
            "run_started_receipt_id": {
              "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "run_id", "receipts", "chain_digest"],
          "properties": {
            "kind": { "const": "RECEIPT_CHAIN" },
            "run_id": { "$ref": "#/$defs/id" },
            "receipts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": { "$ref": "#/$defs/receipt" }
            },
            "chain_digest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operation", "state", "events"],
          "properties": {
            "kind": { "const": "MUTATION" },
            "operation": { "$ref": "#/$defs/mutation_operation" },
            "state": { "enum": ["PREPARED", "IN_FLIGHT", "APPLIED", "NOT_APPLIED", "UNKNOWN"] },
            "events": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50000,
              "items": { "$ref": "#/$defs/mutation_event" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "run_id", "status", "receipt_id"],
          "properties": {
            "kind": { "const": "RECOVERY" },
            "run_id": { "$ref": "#/$defs/id" },
            "status": {
              "enum": [
                "RUN_NOT_FOUND",
                "TERMINAL",
                "UNSTARTED_ALLOCATION_EXPIRED",
                "UNSTARTED_ALLOCATION_ACTIVE",
                "STARTED_LEASE_EXPIRED",
                "LIVE_RUN_NOT_ADOPTABLE"
              ]
            },
            "receipt_id": {
              "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
            }
          }
        }
      ]
    },
    "success_readback_inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "readback"],
      "properties": {
        "kind": { "const": "READBACK_INSPECTION" },
        "readback": { "$ref": "#/$defs/readback" }
      }
    },
    "success_allocate_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "allocation"],
      "properties": {
        "kind": { "const": "ALLOCATE_RUN" },
        "allocation": { "$ref": "#/$defs/run_allocation" }
      }
    },
    "success_start_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "allocation", "started", "run_started_receipt_id"],
      "properties": {
        "kind": { "const": "START_RUN" },
        "allocation": { "$ref": "#/$defs/run_allocation" },
        "started": { "type": "boolean" },
        "run_started_receipt_id": {
          "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        }
      }
    },
    "success_append_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "receipt", "chain_digest"],
      "properties": {
        "kind": { "const": "APPEND_RECEIPT" },
        "receipt": { "$ref": "#/$defs/receipt" },
        "chain_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "success_interrupt_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "receipt"],
      "properties": {
        "kind": { "const": "INTERRUPT_RUN" },
        "receipt": { "$ref": "#/$defs/receipt" }
      }
    },
    "success_mutation_admit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operation"],
      "properties": {
        "kind": { "const": "MUTATION_ADMIT" },
        "operation": { "$ref": "#/$defs/mutation_operation" }
      }
    },
    "success_mutation_dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "event"],
      "properties": {
        "kind": { "const": "MUTATION_DISPATCH" },
        "event": { "$ref": "#/$defs/mutation_event" }
      }
    },
    "success_mutation_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operation", "event"],
      "properties": {
        "kind": { "const": "MUTATION_OUTCOME" },
        "operation": { "$ref": "#/$defs/mutation_operation" },
        "event": { "$ref": "#/$defs/mutation_event" }
      }
    },
    "success_mutation_reconcile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "readback"],
      "properties": {
        "kind": { "const": "MUTATION_RECONCILE" },
        "readback": { "$ref": "#/$defs/readback" }
      }
    },
    "success_orphan_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "recovery"],
      "properties": {
        "kind": { "const": "ORPHAN_RECOVERY" },
        "recovery": { "$ref": "#/$defs/readback" }
      }
    },
    "success_migrate_v2_to_v3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_schema_fingerprint", "result_digest"],
      "properties": {
        "kind": { "const": "MIGRATE_V2_TO_V3" },
        "source_schema_fingerprint": { "$ref": "#/$defs/digest" },
        "result_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "response_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "value", "result_digest"],
      "properties": {
        "operation": {
          "enum": [
            "READBACK_INSPECTION",
            "ALLOCATE_RUN",
            "START_RUN",
            "APPEND_RECEIPT",
            "INTERRUPT_RUN",
            "MUTATION_ADMIT",
            "MUTATION_DISPATCH",
            "MUTATION_OUTCOME",
            "MUTATION_RECONCILE",
            "ORPHAN_RECOVERY",
            "MIGRATE_V2_TO_V3"
          ]
        },
        "value": { "type": "object" },
        "result_digest": { "$ref": "#/$defs/digest" }
      },
      "oneOf": [
        {
          "properties": {
            "operation": { "const": "READBACK_INSPECTION" },
            "value": { "$ref": "#/$defs/success_readback_inspection" }
          }
        },
        {
          "properties": {
            "operation": { "const": "ALLOCATE_RUN" },
            "value": { "$ref": "#/$defs/success_allocate_run" }
          }
        },
        {
          "properties": {
            "operation": { "const": "START_RUN" },
            "value": { "$ref": "#/$defs/success_start_run" }
          }
        },
        {
          "properties": {
            "operation": { "const": "APPEND_RECEIPT" },
            "value": { "$ref": "#/$defs/success_append_receipt" }
          }
        },
        {
          "properties": {
            "operation": { "const": "INTERRUPT_RUN" },
            "value": { "$ref": "#/$defs/success_interrupt_run" }
          }
        },
        {
          "properties": {
            "operation": { "const": "MUTATION_ADMIT" },
            "value": { "$ref": "#/$defs/success_mutation_admit" }
          }
        },
        {
          "properties": {
            "operation": { "const": "MUTATION_DISPATCH" },
            "value": { "$ref": "#/$defs/success_mutation_dispatch" }
          }
        },
        {
          "properties": {
            "operation": { "const": "MUTATION_OUTCOME" },
            "value": { "$ref": "#/$defs/success_mutation_outcome" }
          }
        },
        {
          "properties": {
            "operation": { "const": "MUTATION_RECONCILE" },
            "value": { "$ref": "#/$defs/success_mutation_reconcile" }
          }
        },
        {
          "properties": {
            "operation": { "const": "ORPHAN_RECOVERY" },
            "value": { "$ref": "#/$defs/success_orphan_recovery" }
          }
        },
        {
          "properties": {
            "operation": { "const": "MIGRATE_V2_TO_V3" },
            "value": { "$ref": "#/$defs/success_migrate_v2_to_v3" }
          }
        }
      ]
    },
    "wire_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": [
            "BROKER_MALFORMED_FRAME",
            "BROKER_MALFORMED_REQUEST",
            "BROKER_UNSUPPORTED_SCHEMA",
            "BROKER_UNSUPPORTED_OPERATION",
            "BROKER_INVALID_FIELD",
