{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/repo/scripts/toolkit-codex-session-start.cjs\" --hook --sync-enabled --write --sync-source codex-plugin"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/repo/scripts/toolkit-codex-helper-hook.cjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:Agent|[A-Za-z0-9_-]*spawn_agent|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/repo/scripts/toolkit-codex-helper-hook.cjs\""
          }
        ]
      },
      {
        "matcher": "^(?:apply_patch|Edit|Write|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/repo/scripts/toolkit-codex-helper-hook.cjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?:Bash|mcp__.*[Gg][Ii][Tt][Hh][Uu][Bb].*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/repo/scripts/toolkit-programme-checkpoint-hook.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/repo/scripts/toolkit-programme-checkpoint-hook.cjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
