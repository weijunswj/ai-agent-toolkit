{
  "contract_version": "toolkit.n6.trusted-ci-repository-protection.v1",
  "modes": ["secure-minimal-app", "secure-native", "advisory-only-unsupported"],
  "active_baseline_mode": "secure-minimal-app",
  "secure_native": {
    "requires": ["complete", "policy_semantics", "readback", "entitlement", "publisher"],
    "all_must_be_true": true
  },
  "advisory_only_unsupported": {
    "authoritative_result": "blocked",
    "reason": "unsupported mode cannot become a required check or protection authority"
  },
  "gate": {
    "context": "CI Gate",
    "external_id_prefix": "n6-ci-gate-v1:",
    "identity": ["repository_id", "pr", "head_sha", "base_sha", "merge_sha", "workflow_id", "workflow_path", "approved_source_blob_sha", "run_id", "run_attempt", "job_id", "job_name", "step_number", "step_name", "producer_map_digest", "changed_paths_digest", "contract_digest", "generation"],
    "duplicate_result": "ambiguous-until-readback",
    "head_movement": "stale",
    "base_movement": "stale",
    "merge_movement": "stale"
  },
  "diagnostic_workflow": {
    "workflow_name": "N6 CI diagnostics",
    "job_id": "n6-ci-diagnostics",
    "job_name": "N6 CI diagnostics",
    "reserved_publisher_context": "CI Gate",
    "diagnostic_only": true,
    "candidate_code_execution": false,
    "candidate_evidence_authority": false,
    "required_finality": false,
    "check_run_publication": false,
    "commit_status_publication": false
  },
  "evidence": {
    "schema": "toolkit.n6.ci-server-evidence.v1",
    "producer": "github-actions-server",
    "candidate_declared_components": false,
    "candidate_artifacts": "forbidden",
    "digest": "sha256-over-canonical-server-evidence-without-evidence_digest"
  },
  "composition": {
    "schema": "toolkit.n6.ci-composition.v1",
    "required_owner": "github-actions-server",
    "path_ownership": "github-pull-request-files-server-evaluation",
    "non_authoritative_components": ["git-diff-check"],
    "unknown_relevant_path": "block",
    "candidate_declared_not_applicable": "block",
    "dependency_setup_missing": "block",
    "non_ci_evidence": ["provider-live-uat", "production-deployment", "github-app-installation", "owner-consent", "native-host-uat"]
  },
  "publisher": {
    "protocol_version": "toolkit.n6.app-publisher.v1",
    "kind": "github-app",
    "context": "CI Gate",
    "identity": {
      "field": "app_id",
      "type": "positive-safe-integer",
      "branch_protection_field": "app_id",
      "ruleset_field": "integration_id",
      "check_run_field": "app.id",
      "coercion": false
    },
    "permissions": {
      "checks": "write",
      "statuses": "write",
      "metadata": "read",
      "contents": "read",
      "pull_requests": "read",
      "actions": "read",
      "administration": "none",
      "deployments": "none",
      "secrets": "none",
      "issues": "none",
      "reviews": "none",
      "members": "none",
      "packages": "none",
      "webhooks": "none"
    },
    "operations": {
      "check_run_publication": true,
      "expected_source_enrolment": true,
      "commit_status_publication": false,
      "status_endpoint_publication": false
    },
    "commit_status": false,
    "idempotency": "external_id-bound-readback"
  },
  "protection": {
    "desired_schema": "toolkit.n6.desired-protection.v1",
    "effective_schema": "toolkit.n6.effective-protection.v1",
    "default_branch": "main",
    "managed_key": "n6-ci-gate-v1",
    "provider_ruleset_id": "positive-safe-integer",
    "ownership_classes": ["N6-owned", "organisation-managed", "owner-managed", "overlapping-compatible", "unknown", "overlapping-conflicting"],
    "unknown_or_conflicting": "block",
    "mutation": "preview-only-local-binding",
    "consent_capability": "repository.protection",
    "consent_is_not_provider_authority": true
  },
  "forbidden": {
    "live_provider_calls": true,
    "app_installation": true,
    "required_check_activation": true,
    "ruleset_mutation": true,
    "commit_status_publication": true,
    "status_endpoint_publication": true,
    "provider_uat": true,
    "finality": true
  }
}
