{
  "$schema": "toolkit.github-program.surface.v3",
  "portable_minimum": {
    "parent": [
      "issue",
      "status",
      "outcome",
      "goal",
      "current_child",
      "child_graph",
      "progress",
      "major_holds",
      "predecessor_gateway",
      "next_action"
    ],
    "child": [
      "issue",
      "parent_issue",
      "status",
      "outcome",
      "goal",
      "scope",
      "out_of_scope",
      "downstream_owned",
      "current_gate",
      "current_phase",
      "next_gate",
      "progress",
      "achieved",
      "remaining",
      "holds",
      "current_obligation",
      "dependencies",
      "epochs",
      "lock",
      "predecessor_issues",
      "predecessor_gateway",
      "pr_registry",
      "candidate",
      "boundaries",
      "next_action",
      "eli5"
    ],
    "pr": [
      "number",
      "parent_issue",
      "child_issue",
      "state",
      "outcome",
      "purpose",
      "scope",
      "out_of_scope",
      "progress",
      "achieved",
      "remaining",
      "safety_constraints",
      "validation_status",
      "epoch",
      "lock",
      "branch",
      "base",
      "head",
      "tree",
      "version",
      "role",
      "completes_child",
      "changed_surfaces",
      "validation",
      "holds",
      "finality",
      "next_action",
      "eli5"
    ]
  },
  "repository_extensions": {
    "field": "extensions",
    "semantics": "additive-only",
    "portable_fields_may_not_be_overridden": true
  },
  "lifecycle_labels": {
    "exclusive": true,
    "values": [
      "completed",
      "current",
      "queued",
      "blocked"
    ]
  },
  "rendering": {
    "one_line_outcome_required": true,
    "markdown_tables_required_for_repeated_structures": true
  },
  "whole_body_freshness": {
    "current_programme_source_count": 1,
    "managed_block_and_unmanaged_text_validated_together": true,
    "structurally_anchored_competing_projection_detection": true,
    "clearly_historical_context_allowed": true,
    "repository_extensions_may_not_project_competing_current_state": true,
    "readback_and_zero_delta_require_fresh_whole_bodies": true,
    "stale_projection_migration": {
      "schema": "toolkit.github-program.stale-projection-migration.v2",
      "trusted_web_adjudication_required": true,
      "whole_body_digest_required": true,
      "exact_recognised_spans_required": true,
      "stale_span_digests_required": true,
      "resulting_body_digest_required": true,
      "unrelated_bytes_preserved": true,
      "arbitrary_owner_prose_rejected": true
    }
  }
}
