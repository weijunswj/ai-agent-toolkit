{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.github-program.scope-grant.v1",
  "title": "Trusted programme scope grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "parent_issue", "children", "dependencies", "associated_prs", "api_version", "complete", "pagination", "revision", "source_digests", "version_resolver"],
  "properties": {
    "schema": { "const": "toolkit.github-program.scope-grant.v1" },
    "repository": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\r\\n]+$" },
    "parent_issue": { "type": "integer", "minimum": 1 },
    "children": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
    "dependencies": { "type": "object", "maxProperties": 50, "additionalProperties": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } } },
    "associated_prs": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
    "api_version": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\r\\n]+$" },
    "complete": { "const": true },
    "pagination": { "type": "object", "additionalProperties": false, "required": ["complete"], "properties": { "complete": { "const": true } } },
    "revision": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$" },
    "source_digests": { "type": "array", "maxItems": 50, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "scope_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "version_resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "kind", "agreement", "sources"],
      "properties": {
        "identity": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "kind": { "const": "json-pointer-agreement" },
        "agreement": { "const": "all" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "pointer"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n]+$" },
              "pointer": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$" }
            }
          }
        }
      }
    }
  }
}
