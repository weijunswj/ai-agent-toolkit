{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.github-program.controller-bootstrap.v1",
  "title": "Trusted v5 programme projection bootstrap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "repository",
    "parent_issue",
    "programme_state_schema",
    "surface_contract_schema",
    "toolkit_package_version",
    "toolkit_contract",
    "governance",
    "conformance",
    "compatibility"
  ],
  "properties": {
    "schema": {
      "const": "toolkit.github-program.controller-bootstrap.v1"
    },
    "profile": {
      "const": "github-managed-programme"
    },
    "repository": {
      "const": "weijunswj/ai-agent-toolkit"
    },
    "parent_issue": {
      "const": 240
    },
    "programme_state_schema": {
      "const": "toolkit.github-program.state.v5"
    },
    "surface_contract_schema": {
      "const": "toolkit.github-program.surface.v5"
    },
    "toolkit_package_version": {
      "const": "2.11.2"
    },
    "toolkit_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "path",
        "sha256"
      ],
      "properties": {
        "repository": {
          "const": "weijunswj/ai-agent-toolkit"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "const": "repo/contracts/github-program-reconciler/programme-surface-contract-v5.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "repository_identity", "managed_programme"],
      "properties": {
        "state": { "enum": ["enabled", "disabled", "unresolved"] },
        "repository_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "admitted"],
          "properties": {
            "repository": { "const": "weijunswj/ai-agent-toolkit" },
            "admitted": { "type": "boolean" }
          }
        },
        "managed_programme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "parent_issue", "surface_version"],
          "properties": {
            "status": { "enum": ["BOUND", "UNBOUND"] },
            "parent_issue": { "type": "integer", "minimum": 1 },
            "surface_version": { "type": "string", "pattern": "^human-v2$" }
          }
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_workspace_bytes",
        "canonical_json",
        "historical_git_object_required",
        "resolver",
        "source_revision_pinned"
      ],
      "properties": {
        "actual_workspace_bytes": {
          "const": true
        },
        "canonical_json": {
          "const": true
        },
        "historical_git_object_required": {
          "const": false
        },
        "resolver": {
          "const": "unchanged"
        },
        "source_revision_pinned": {
          "const": true
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fail_closed_on_unknown_major",
        "provider_cas_claim",
        "receipt_source_changed"
      ],
      "properties": {
        "fail_closed_on_unknown_major": {
          "const": true
        },
        "provider_cas_claim": {
          "const": false
        },
        "receipt_source_changed": {
          "const": false
        }
      }
    }
  }
}
