{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.github-program.controller-bootstrap.v1",
  "title": "Pinned Web controller bootstrap for a managed GitHub programme",
  "description": "The target repository identifies the programme; toolkit_contract separately identifies the immutable Toolkit contract source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "repository",
    "parent_issue",
    "programme_state_schema",
    "surface_contract_schema",
    "toolkit_package_version",
    "toolkit_contract",
    "conformance",
    "compatibility"
  ],
  "properties": {
    "$schema": { "const": "toolkit.github-program.controller-bootstrap.v1" },
    "schema": { "const": "toolkit.github-program.controller-bootstrap.v1" },
    "profile": { "const": "github-managed-programme" },
    "repository": { "$ref": "#/$defs/safeLine" },
    "parent_issue": { "$ref": "#/$defs/issue" },
    "programme_state_schema": { "const": "toolkit.github-program.state.v5" },
    "surface_contract_schema": { "const": "toolkit.github-program.surface.v5" },
    "toolkit_package_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "toolkit_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "path", "sha256"],
      "properties": {
        "repository": { "$ref": "#/$defs/safeLine" },
        "revision": { "$ref": "#/$defs/sha" },
        "path": { "const": "repo/contracts/github-program-reconciler/programme-surface-contract-v5.json" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_class", "migration_from"],
      "properties": {
        "required_class": { "const": "CURRENT_MANAGED" },
        "migration_from": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "const": "toolkit.github-program.state.v4" },
          "uniqueItems": true
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fail_closed_on_unknown_major"],
      "properties": {
        "fail_closed_on_unknown_major": { "const": true }
      }
    }
  },
  "$defs": {
    "issue": { "type": "integer", "minimum": 1 },
    "safeLine": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n]+$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
