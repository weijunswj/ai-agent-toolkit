{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.github-program.trusted-pr-inspection.v1",
  "title": "Trusted exact-head PR inspection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "scope_digest", "resolver_identity", "complete", "facts"],
  "properties": {
    "schema": { "const": "toolkit.github-program.trusted-pr-inspection.v1" },
    "repository": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\r\\n]+$" },
    "scope_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resolver_identity": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "complete": { "const": true },
    "facts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "parent_issue", "child_issue", "branch", "base", "head", "tree", "version", "lifecycle", "version_source_digests"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "parent_issue": { "type": "integer", "minimum": 1 },
          "child_issue": { "type": "integer", "minimum": 1 },
          "branch": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$" },
          "base": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "head": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "version": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\r\\n]+$" },
          "lifecycle": { "enum": ["OPEN_DRAFT", "OPEN_READY", "MERGED", "CLOSED_UNMERGED"] },
          "version_source_digests": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
        }
      }
    }
  }
}
