{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.github-program.extensions.v1",
  "title": "Additive programme extensions v1",
  "$defs": {
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "namespace", "target", "class", "title", "payload"],
      "properties": {
        "schema": { "const": "toolkit.github-program.extensions.v1" },
        "namespace": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "number"],
          "properties": {
            "kind": { "enum": ["parent", "child", "pr"] },
            "number": { "type": "integer", "minimum": 1 }
          }
        },
        "class": { "enum": ["INFORMATION", "EVIDENCE", "POLICY", "DOMAIN_HEALTH", "TABLE", "PROVENANCE"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\r\\n]+$" },
        "payload": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["text"], "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 4096 } } },
            { "type": "object", "additionalProperties": false, "required": ["summary"], "properties": { "summary": { "type": "string", "minLength": 1, "maxLength": 4096 }, "references": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$" } } } },
            { "type": "object", "additionalProperties": false, "required": ["domain", "status", "summary"], "properties": { "domain": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\r\\n]+$" }, "status": { "enum": ["PASS", "WARN", "FAIL", "UNKNOWN", "NOT_APPLICABLE"] }, "summary": { "type": "string", "minLength": 1, "maxLength": 4096 } } },
            { "type": "object", "additionalProperties": false, "required": ["columns", "rows"], "properties": { "columns": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\r\\n]+$" } }, "rows": { "type": "array", "maxItems": 100, "items": { "type": "array", "maxItems": 12, "items": { "type": ["string", "number", "boolean"], "maxLength": 256 } } } } }
          ]
        }
      }
    }
  },
  "$ref": "#/$defs/extension"
}
