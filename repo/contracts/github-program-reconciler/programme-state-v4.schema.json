{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.github-program.state.v4",
  "title": "Canonical GitHub programme state v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "design_lock", "repository", "parent", "children", "prs", "cursor", "candidate", "predecessor_contract_digest", "evidence_refs", "historical_transitions", "extensions"],
  "properties": {
    "schema": { "const": "toolkit.github-program.state.v4" },
    "design_lock": { "const": "DL-S2-GITHUB-PROGRAM-CONVERGENCE-002" },
    "repository": { "$ref": "#/$defs/safeLine" },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "title", "goal"],
      "properties": {
        "issue": { "$ref": "#/$defs/issue" },
        "title": { "$ref": "#/$defs/safeLine" },
        "goal": { "$ref": "#/$defs/safeText" }
      }
    },
    "children": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/child" } },
    "prs": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/pr" } },
    "cursor": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cursor" }] },
    "candidate": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/candidate" }] },
    "predecessor_contract_digest": { "$ref": "#/$defs/digest" },
    "evidence_refs": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/evidence" } },
    "historical_transitions": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/transition" } },
    "extensions": { "type": "array", "maxItems": 50, "items": { "$ref": "programme-extensions-v1.schema.json#/$defs/extension" } }
  },
  "$defs": {
    "issue": { "type": "integer", "minimum": 1 },
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "safeLine": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n]+$" },
    "safeText": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "textArray": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/safeText" } },
    "finality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "authority_ref"],
      "properties": {
        "state": { "enum": ["HELD", "READY_AUTHORIZED", "MERGED", "RETIRED"] },
        "authority_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }] }
      }
    },
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "lock", "purpose", "gates", "terminal_disposition", "evidence_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "name": { "$ref": "#/$defs/safeLine" },
        "lock": { "$ref": "#/$defs/safeId" },
        "purpose": { "$ref": "#/$defs/safeText" },
        "gates": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/safeId" }, "uniqueItems": true },
        "terminal_disposition": { "enum": [null, "ACCEPTED", "RETIRED"] },
        "evidence_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }] }
      }
    },
    "hold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "summary", "evidence_ref", "active"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "kind": { "enum": ["BLOCKING", "INFORMATIONAL"] },
        "summary": { "$ref": "#/$defs/safeText" },
        "evidence_ref": { "$ref": "#/$defs/safeId" },
        "active": { "type": "boolean" }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr", "status", "role", "completes_child", "epoch_id", "accepted_evidence_ref", "retirement_evidence_ref"],
      "properties": {
        "pr": { "$ref": "#/$defs/issue" },
        "status": { "enum": ["ACTIVE", "ACCEPTED", "RETIRED"] },
        "role": { "enum": ["INTERMEDIATE", "TERMINAL"] },
        "completes_child": { "type": "boolean" },
        "epoch_id": { "$ref": "#/$defs/safeId" },
        "accepted_evidence_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }] },
        "retirement_evidence_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }] }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "order", "title", "objective", "lifecycle", "dependencies", "scope", "out_of_scope", "boundaries", "eli5", "epochs", "holds", "pr_registry", "finality"],
      "properties": {
        "issue": { "$ref": "#/$defs/issue" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/safeLine" },
        "objective": { "$ref": "#/$defs/safeText" },
        "lifecycle": { "enum": ["QUEUED", "CURRENT", "COMPLETED", "RETIRED"] },
        "dependencies": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/issue" }, "uniqueItems": true },
        "scope": { "$ref": "#/$defs/textArray" },
        "out_of_scope": { "$ref": "#/$defs/textArray" },
        "boundaries": { "$ref": "#/$defs/textArray" },
        "eli5": { "$ref": "#/$defs/safeText" },
        "epochs": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/epoch" } },
        "holds": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/hold" } },
        "pr_registry": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/registry" } },
        "finality": { "$ref": "#/$defs/finality" }
      }
    },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "child_issue", "purpose", "scope", "out_of_scope", "design_constraints", "changed_surfaces", "eli5"],
      "properties": {
        "number": { "$ref": "#/$defs/issue" },
        "child_issue": { "$ref": "#/$defs/issue" },
        "purpose": { "$ref": "#/$defs/safeText" },
        "scope": { "$ref": "#/$defs/textArray" },
        "out_of_scope": { "$ref": "#/$defs/textArray" },
        "design_constraints": { "$ref": "#/$defs/textArray" },
        "changed_surfaces": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/safeLine" } },
        "eli5": { "$ref": "#/$defs/safeText" }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child_issue", "epoch_id", "gate", "status", "result"],
      "properties": {
        "child_issue": { "$ref": "#/$defs/issue" },
        "epoch_id": { "$ref": "#/$defs/safeId" },
        "gate": { "$ref": "#/$defs/safeId" },
        "status": { "enum": ["ACTIVE", "RESULT_RECORDED"] },
        "result": { "enum": [null, "AMEND", "PASS"] }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr", "branch", "base_ref", "base_sha", "head", "tree", "version", "epoch_id"],
      "properties": {
        "pr": { "$ref": "#/$defs/issue" },
        "branch": { "$ref": "#/$defs/safeLine" },
        "base_ref": { "$ref": "#/$defs/safeLine" },
        "base_sha": { "$ref": "#/$defs/sha" },
        "head": { "$ref": "#/$defs/sha" },
        "tree": { "$ref": "#/$defs/sha" },
        "version": { "$ref": "#/$defs/safeLine" },
        "epoch_id": { "$ref": "#/$defs/safeId" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "reference", "summary"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "kind": { "enum": ["WEB", "COMMIT", "PR", "CHECK", "REVIEW", "ISSUE", "MIGRATION"] },
        "reference": { "$ref": "#/$defs/safeLine" },
        "summary": { "$ref": "#/$defs/safeLine" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "child_issue", "epoch_id", "gate", "disposition", "evidence_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "child_issue": { "$ref": "#/$defs/issue" },
        "epoch_id": { "$ref": "#/$defs/safeId" },
        "gate": { "$ref": "#/$defs/safeId" },
        "disposition": { "enum": ["ACCEPTED", "AMEND", "PASS", "RETIRED"] },
        "evidence_ref": { "$ref": "#/$defs/safeId" }
      }
    }
  }
}
