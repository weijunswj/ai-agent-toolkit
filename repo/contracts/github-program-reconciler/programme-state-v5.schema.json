{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.github-program.state.v5",
  "title": "Canonical GitHub programme state v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "design_lock",
    "repository",
    "parent",
    "children",
    "prs",
    "concurrency_authority",
    "active_lanes",
    "predecessor_contract_digest",
    "evidence_refs",
    "historical_transitions",
    "extensions"
  ],
  "properties": {
    "schema": { "const": "toolkit.github-program.state.v5" },
    "design_lock": { "const": "DL-S2-GITHUB-PROGRAM-SURFACE-RECOVERY-003" },
    "repository": { "$ref": "#/$defs/safeLine" },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "title", "goal"],
      "properties": {
        "issue": { "$ref": "#/$defs/issue" },
        "title": { "$ref": "#/$defs/safeLine" },
        "goal": { "$ref": "#/$defs/safeText" }
      }
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/child" }
    },
    "prs": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/pr" }
    },
    "concurrency_authority": { "$ref": "#/$defs/concurrencyAuthority" },
    "active_lanes": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/lane" }
    },
    "predecessor_contract_digest": { "$ref": "#/$defs/digest" },
    "evidence_refs": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "historical_transitions": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/transition" }
    },
    "extensions": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "programme-extensions-v1.schema.json#/$defs/extension" }
    }
  },
  "$defs": {
    "issue": { "type": "integer", "minimum": 1 },
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "safeLine": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n]+$" },
    "safeText": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "textArray": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/safeText" }
    },
    "finality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "authority_ref"],
      "properties": {
        "state": { "enum": ["HELD", "READY_AUTHORIZED", "MERGED", "RETIRED"] },
        "authority_ref": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }]
        }
      }
    },
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "lock", "purpose", "gates", "terminal_disposition", "evidence_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "name": { "$ref": "#/$defs/safeLine" },
        "lock": { "$ref": "#/$defs/safeId" },
        "purpose": { "$ref": "#/$defs/safeText" },
        "gates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/$defs/safeId" },
          "uniqueItems": true
        },
        "terminal_disposition": { "enum": [null, "ACCEPTED", "RETIRED"] },
        "evidence_ref": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }]
        }
      }
    },
    "hold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "summary", "evidence_ref", "active"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "kind": { "enum": ["BLOCKING", "INFORMATIONAL"] },
        "summary": { "$ref": "#/$defs/safeText" },
        "evidence_ref": { "$ref": "#/$defs/safeId" },
        "active": { "type": "boolean" }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr", "status", "role", "completes_child", "epoch_id", "accepted_evidence_ref", "retirement_evidence_ref"],
      "properties": {
        "pr": { "$ref": "#/$defs/issue" },
        "status": { "enum": ["ACTIVE", "ACCEPTED", "RETIRED"] },
        "role": { "enum": ["INTERMEDIATE", "TERMINAL"] },
        "completes_child": { "type": "boolean" },
        "epoch_id": { "$ref": "#/$defs/safeId" },
        "accepted_evidence_ref": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }]
        },
        "retirement_evidence_ref": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeId" }]
        }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "order",
        "title",
        "summary",
        "objective",
        "deliverables",
        "done_when",
        "lifecycle",
        "dependencies",
        "scope",
        "out_of_scope",
        "boundaries",
        "eli5",
        "epochs",
        "holds",
        "pr_registry",
        "finality"
      ],
      "properties": {
        "issue": { "$ref": "#/$defs/issue" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/safeLine" },
        "summary": { "$ref": "#/$defs/safeText" },
        "objective": { "$ref": "#/$defs/safeText" },
        "deliverables": { "$ref": "#/$defs/textArray" },
        "done_when": { "$ref": "#/$defs/textArray" },
        "lifecycle": { "enum": ["QUEUED", "CURRENT", "COMPLETED", "RETIRED"] },
        "dependencies": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/issue" },
          "uniqueItems": true
        },
        "scope": { "$ref": "#/$defs/textArray" },
        "out_of_scope": { "$ref": "#/$defs/textArray" },
        "boundaries": { "$ref": "#/$defs/textArray" },
        "eli5": { "$ref": "#/$defs/safeText" },
        "epochs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/$defs/epoch" }
        },
        "holds": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/hold" }
        },
        "pr_registry": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/registry" }
        },
        "finality": { "$ref": "#/$defs/finality" }
      }
    },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "child_issue",
        "summary",
        "purpose",
        "scope",
        "out_of_scope",
        "design_constraints",
        "changed_surfaces",
        "validation_requirements",
        "evidence_refs",
        "eli5"
      ],
      "properties": {
        "number": { "$ref": "#/$defs/issue" },
        "child_issue": { "$ref": "#/$defs/issue" },
        "summary": { "$ref": "#/$defs/safeText" },
        "purpose": { "$ref": "#/$defs/safeText" },
        "scope": { "$ref": "#/$defs/textArray" },
        "out_of_scope": { "$ref": "#/$defs/textArray" },
        "design_constraints": { "$ref": "#/$defs/textArray" },
        "changed_surfaces": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/safeLine" }
        },
        "validation_requirements": { "$ref": "#/$defs/textArray" },
        "evidence_refs": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/safeId" },
          "uniqueItems": true
        },
        "eli5": { "$ref": "#/$defs/safeText" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr", "branch", "base_ref", "base_sha", "head", "tree", "version", "epoch_id"],
      "properties": {
        "pr": { "$ref": "#/$defs/issue" },
        "branch": { "$ref": "#/$defs/safeLine" },
        "base_ref": { "$ref": "#/$defs/safeLine" },
        "base_sha": { "$ref": "#/$defs/sha" },
        "head": { "$ref": "#/$defs/sha" },
        "tree": { "$ref": "#/$defs/sha" },
        "version": { "$ref": "#/$defs/safeLine" },
        "epoch_id": { "$ref": "#/$defs/safeId" }
      }
    },
    "workClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "resource"],
      "properties": {
        "mode": { "enum": ["READ", "WRITE"] },
        "resource": { "$ref": "#/$defs/safeLine" },
        "operation": { "$ref": "#/$defs/safeId" },
        "scope": { "$ref": "#/$defs/safeLine" }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane_id", "child_issue", "epoch_id", "gate", "gate_state", "gate_result", "candidate", "work_claims"],
      "properties": {
        "lane_id": { "$ref": "#/$defs/safeId" },
        "child_issue": { "$ref": "#/$defs/issue" },
        "epoch_id": { "$ref": "#/$defs/safeId" },
        "gate": { "$ref": "#/$defs/safeId" },
        "gate_state": { "enum": ["ACTIVE", "RESULT_RECORDED", "WEB_DECISION_REQUIRED", "AWAITING_FINALITY"] },
        "gate_result": { "enum": [null, "AMEND", "PASS"] },
        "candidate": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/candidate" }]
        },
        "work_claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/workClaim" }
        }
      }
    },
    "concurrencyAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "max_active_lanes", "authority_ref", "authority_digest", "permitted_child_issues"],
      "properties": {
        "mode": { "enum": ["SINGLE_DEFAULT", "EXPLICIT_BOUNDED"] },
        "max_active_lanes": { "type": "integer", "minimum": 1, "maximum": 50 },
        "authority_ref": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeLine" }]
        },
        "authority_digest": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }]
        },
        "permitted_child_issues": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/issue" },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "reference", "summary"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "kind": { "enum": ["WEB", "COMMIT", "PR", "CHECK", "REVIEW", "ISSUE", "MIGRATION"] },
        "reference": { "$ref": "#/$defs/safeLine" },
        "summary": { "$ref": "#/$defs/safeLine" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "child_issue", "epoch_id", "gate", "disposition", "evidence_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "child_issue": { "$ref": "#/$defs/issue" },
        "epoch_id": { "$ref": "#/$defs/safeId" },
        "gate": { "$ref": "#/$defs/safeId" },
        "disposition": { "enum": ["ACCEPTED", "AMEND", "PASS", "RETIRED"] },
        "evidence_ref": { "$ref": "#/$defs/safeId" }
      }
    }
  }
}
