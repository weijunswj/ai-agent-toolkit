{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.github-program.state.v5",
  "title": "Canonical v5 GitHub programme state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "design_lock",
    "repository",
    "parent",
    "children",
    "prs",
    "concurrency_authority",
    "active_lanes",
    "predecessor_contract_digest",
    "evidence_refs",
    "historical_transitions",
    "extensions"
  ],
  "properties": {
    "schema": {
      "const": "toolkit.github-program.state.v5"
    },
    "design_lock": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "repository": {
      "const": "weijunswj/ai-agent-toolkit"
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "issue",
        "title"
      ],
      "properties": {
        "goal": {
          "type": "string"
        },
        "issue": {
          "const": 240
        },
        "title": {
          "type": "string"
        }
      }
    },
    "children": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "boundaries",
          "deliverables",
          "dependencies",
          "done_when",
          "eli5",
          "epochs",
          "finality",
          "holds",
          "issue",
          "lifecycle",
          "objective",
          "order",
          "out_of_scope",
          "pr_registry",
          "scope",
          "summary",
          "title"
        ],
        "properties": {
          "boundaries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "done_when": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "eli5": {
            "type": "string"
          },
          "epochs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_ref",
                "gates",
                "id",
                "lock",
                "name",
                "purpose",
                "terminal_disposition"
              ],
              "properties": {
                "evidence_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "gates": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "id": {
                  "type": "string"
                },
                "lock": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                },
                "terminal_disposition": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    null,
                    "ACCEPTED",
                    "REJECTED",
                    "AMEND"
                  ]
                }
              }
            }
          },
          "finality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "authority_ref",
              "state"
            ],
            "properties": {
              "authority_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "state": {
                "enum": [
                  "HELD",
                  "MERGED",
                  "UNMERGED"
                ]
              }
            }
          },
          "holds": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "active",
                "blocks_normal_lanes",
                "evidence_ref",
                "id",
                "kind",
                "lock",
                "root",
                "scope",
                "summary"
              ],
              "properties": {
                "active": {
                  "type": "boolean"
                },
                "blocks_normal_lanes": {
                  "type": "boolean"
                },
                "evidence_ref": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "lock": {
                  "type": "string"
                },
                "root": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                }
              }
            }
          },
          "issue": {
            "type": "integer",
            "minimum": 1
          },
          "lifecycle": {
            "enum": [
              "COMPLETED",
              "CURRENT",
              "QUEUED"
            ]
          },
          "objective": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "out_of_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pr_registry": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "accepted_evidence_ref",
                "completes_child",
                "epoch_id",
                "pr",
                "retirement_evidence_ref",
                "role",
                "status"
              ],
              "properties": {
                "accepted_evidence_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "candidate": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "repository",
                    "branch",
                    "base_ref",
                    "base_sha",
                    "head",
                    "tree",
                    "version"
                  ],
                  "properties": {
                    "repository": {
                      "const": "weijunswj/ai-agent-toolkit"
                    },
                    "branch": {
                      "type": "string"
                    },
                    "base_ref": {
                      "const": "main"
                    },
                    "base_sha": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    },
                    "head": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    },
                    "tree": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    },
                    "version": {
                      "type": "string"
                    }
                  }
                },
                "completes_child": {
                  "type": "boolean"
                },
                "draft": {
                  "type": "boolean"
                },
                "epoch_id": {
                  "type": "string"
                },
                "github_state": {
                  "enum": [
                    "OPEN",
                    "CLOSED",
                    "MERGED"
                  ]
                },
                "merged": {
                  "type": "boolean"
                },
                "pr": {
                  "type": "integer",
                  "minimum": 1
                },
                "retention_evidence_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "retirement_evidence_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "role": {
                  "const": "INTERMEDIATE"
                },
                "status": {
                  "enum": [
                    "ACTIVE",
                    "ACCEPTED",
                    "RETIRED",
                    "RETAINED"
                  ]
                }
              }
            }
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "prs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "changed_surfaces",
          "child_issue",
          "design_constraints",
          "evidence_refs",
          "number",
          "out_of_scope",
          "purpose",
          "scope",
          "summary",
          "validation_requirements"
        ],
        "properties": {
          "changed_surfaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "child_issue": {
            "type": "integer",
            "minimum": 1
          },
          "design_constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "eli5": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "out_of_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "purpose": {
            "type": "string"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
        "validation_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "repository",
            "branch",
            "base_ref",
            "base_sha",
            "head",
            "tree",
            "version"
          ],
          "properties": {
            "repository": { "type": "string" },
            "branch": { "type": "string" },
            "base_ref": { "type": "string" },
            "base_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "head": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "version": { "type": "string" }
          }
        }
        }
      }
    },
    "concurrency_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_digest",
        "authority_ref",
        "max_active_lanes",
        "mode",
        "permitted_child_issues"
      ],
      "properties": {
        "authority_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_active_lanes": {
          "const": 1
        },
        "mode": {
          "const": "SINGLE_DEFAULT"
        },
        "permitted_child_issues": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "active_lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate",
          "child_issue",
          "epoch_id",
          "gate",
          "gate_result",
          "gate_state",
          "lane_id",
          "work_claims"
        ],
        "properties": {
          "candidate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base_ref",
              "base_sha",
              "branch",
              "epoch_id",
              "head",
              "pr",
              "tree",
              "version"
            ],
            "properties": {
              "base_ref": {
                "type": "string"
              },
              "base_sha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "branch": {
                "type": "string"
              },
              "epoch_id": {
                "type": "string"
              },
              "head": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "pr": {
                "type": "integer",
                "minimum": 1
              },
              "tree": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "version": {
                "type": "string"
              }
            }
          },
          "child_issue": {
            "type": "integer",
            "minimum": 1
          },
          "epoch_id": {
            "type": "string"
          },
          "gate": {
            "type": "string"
          },
          "gate_result": {
            "type": [
              "string",
              "null"
            ]
          },
          "gate_state": {
            "const": "ACTIVE"
          },
          "lane_id": {
            "type": "string"
          },
          "work_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "operation",
                "resource"
              ],
              "properties": {
                "mode": {
                  "type": "string"
                },
                "operation": {
                  "type": "string"
                },
                "resource": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "predecessor_contract_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "reference",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "historical_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "child_issue",
          "disposition",
          "epoch_id",
          "evidence_ref",
          "gate",
          "id"
        ],
        "properties": {
          "child_issue": {
            "type": "integer",
            "minimum": 1
          },
          "disposition": {
            "type": "string"
          },
          "epoch_id": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string"
          },
          "gate": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "lock",
        "status",
        "normal_active_lanes",
        "active_blocking_recovery_hold",
        "e3_status",
        "e4_status",
        "queued_children",
        "old_root",
        "parked_root"
      ],
      "properties": {
        "root": {
          "const": "E3-V5-PROGRAMME-PROJECTION-BOOTSTRAP-RECOVERY-001"
        },
        "lock": {
          "const": "DL-S2-E3-V5-PROJECTION-BOOTSTRAP-RECOVERY-001"
        },
        "status": {
          "const": "HELD"
        },
        "normal_active_lanes": {
          "const": 0
        },
        "active_blocking_recovery_hold": {
          "const": true
        },
        "e3_status": {
          "const": "UNACCEPTED"
        },
        "e4_status": {
          "const": "PENDING"
        },
        "queued_children": {
          "const": [
            360,
            361,
            362,
            363
          ]
        },
        "old_root": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "disposition",
            "terminal",
            "repair_budget"
          ],
          "properties": {
            "root": {
              "const": "E3-CANONICAL-HISTORICAL-RECEIPT-RESOLUTION-003"
            },
            "disposition": {
              "const": "NON_CONVERGENT"
            },
            "terminal": {
              "const": true
            },
            "repair_budget": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "used",
                "limit",
                "further_repair_authorised"
              ],
              "properties": {
                "used": {
                  "const": 2
                },
                "limit": {
                  "const": 2
                },
                "further_repair_authorised": {
                  "const": false
                }
              }
            }
          }
        },
        "parked_root": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "status"
          ],
          "properties": {
            "root": {
              "const": "E3-HISTORICAL-RECEIPT-CI-PROOF-BOUNDARY-SIMPLIFICATION-004"
            },
            "status": {
              "const": "NOT_LAUNCHED"
            }
          }
        }
      }
    }
  }
}
