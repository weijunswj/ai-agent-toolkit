{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.github-program.migration.v1",
  "title": "Programme v1 to canonical v4 migration preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "code", "schema", "preview_kind", "repository", "parent_issue", "authority_ref", "expected_revision", "source_snapshot_digest", "source_body_digests", "source_state_digests", "semantic_mapping", "semantic_mapping_digest", "target_canonical_digest", "target_managed_body_digests", "target_body_digests", "target_projection_digests", "scope_digest", "trusted_pr_inspection_digest", "trusted_relationship_inspection_digest", "relationship_capability_digest", "required_relationship_operations", "candidate_binding_digest", "expected_event_inventory_digest", "expected_snapshot_digest", "operations", "operations_digest", "ordered_operation_ids", "mutation_authority", "finality_authority", "preview_id", "expected_snapshot"],
  "properties": {
    "ok": { "const": true },
    "code": { "const": "PROGRAMME_MIGRATION_PREVIEW_READY" },
    "schema": { "const": "toolkit.github-program.migration.v1" },
    "preview_kind": { "const": "MIGRATION" },
    "repository": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\r\\n]+$" },
    "parent_issue": { "type": "integer", "minimum": 1 },
    "authority_ref": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$" },
    "expected_revision": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$" },
    "source_snapshot_digest": { "$ref": "#/$defs/digest" },
    "source_body_digests": { "$ref": "#/$defs/bodyDigests" },
    "source_state_digests": { "$ref": "#/$defs/bodyDigests" },
    "semantic_mapping": { "$ref": "#/$defs/semanticMapping" },
    "semantic_mapping_digest": { "$ref": "#/$defs/digest" },
    "target_canonical_digest": { "$ref": "#/$defs/digest" },
    "target_managed_body_digests": { "$ref": "#/$defs/bodyDigests" },
    "target_body_digests": { "$ref": "#/$defs/bodyDigests" },
    "target_projection_digests": { "$ref": "#/$defs/bodyDigests" },
    "scope_digest": { "$ref": "#/$defs/digest" },
    "trusted_pr_inspection_digest": { "$ref": "#/$defs/digest" },
    "trusted_relationship_inspection_digest": { "$ref": "#/$defs/digest" },
    "relationship_capability_digest": { "$ref": "#/$defs/digest" },
    "required_relationship_operations": { "$ref": "#/$defs/relationshipOperations" },
    "candidate_binding_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "expected_event_inventory_digest": { "$ref": "#/$defs/digest" },
    "expected_snapshot_digest": { "$ref": "#/$defs/digest" },
    "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
    "operations_digest": { "$ref": "#/$defs/digest" },
    "ordered_operation_ids": { "type": "array", "items": { "$ref": "#/$defs/digest" } },
    "mutation_authority": { "const": "NOT_GRANTED" },
    "finality_authority": { "const": "NOT_GRANTED" },
    "preview_id": { "$ref": "#/$defs/digest" },
    "expected_snapshot": { "$ref": "#/$defs/expectedSnapshot" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relationshipOperations": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "enum": ["CHILD_MEMBERSHIP", "DEPENDENCY_EDGES", "PR_ASSOCIATION"] } },
    "digestMap": { "type": "object", "propertyNames": { "pattern": "^[1-9][0-9]*$" }, "additionalProperties": { "$ref": "#/$defs/digest" } },
    "bodyDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent", "children", "prs"],
      "properties": {
        "parent": { "$ref": "#/$defs/digest" },
        "children": { "$ref": "#/$defs/digestMap" },
        "prs": { "$ref": "#/$defs/digestMap" }
      }
    },
    "bodySet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent", "children", "prs"],
      "properties": {
        "parent": { "type": "string", "maxLength": 65536 },
        "children": { "type": "object", "propertyNames": { "pattern": "^[1-9][0-9]*$" }, "additionalProperties": { "type": "string", "maxLength": 65536 } },
        "prs": { "type": "object", "propertyNames": { "pattern": "^[1-9][0-9]*$" }, "additionalProperties": { "type": "string", "maxLength": 65536 } }
      }
    },
    "expectedSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "complete", "canonical_state", "bodies", "labels", "managed_events", "native"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 200 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "complete": { "const": true },
        "canonical_state": { "$ref": "programme-state-v4.schema.json" },
        "bodies": { "$ref": "#/$defs/bodySet" },
        "labels": { "type": "object" },
        "managed_events": { "type": "array", "maxItems": 500, "items": { "type": "object" } },
        "native": { "type": "object" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "before_digest", "after", "after_digest", "operation_id"],
      "properties": {
        "kind": { "enum": ["migrate-parent-body", "migrate-child-body", "migrate-pr-body", "managed-event", "labels", "relationships"] },
        "target": { "type": "integer", "minimum": 1 },
        "before_digest": { "$ref": "#/$defs/digest" },
        "after": {},
        "after_digest": { "$ref": "#/$defs/digest" },
        "required_relationship_operations": { "$ref": "#/$defs/relationshipOperations" },
        "relationship_capability_digest": { "$ref": "#/$defs/digest" },
        "operation_id": { "$ref": "#/$defs/digest" }
      },
      "allOf": [{
        "if": { "properties": { "kind": { "const": "relationships" } }, "required": ["kind"] },
        "then": { "required": ["required_relationship_operations", "relationship_capability_digest"] }
      }]
    },
    "semanticMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "identity_scope", "source_model_digest", "target_canonical_digest", "correction_authority_ref", "correction_evidence_id", "admitted_source_contradictions"],
      "properties": {
        "schema": { "const": "toolkit.github-program.migration-mapping.v1" },
        "identity_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "parent_issue", "children", "dependencies", "associated_prs"],
          "properties": {
            "repository": { "type": "string", "minLength": 1, "maxLength": 200 },
            "parent_issue": { "type": "integer", "minimum": 1 },
            "children": { "type": "array", "maxItems": 50, "items": { "type": "integer", "minimum": 1 } },
            "dependencies": { "type": "object" },
            "associated_prs": { "type": "array", "maxItems": 100, "items": { "type": "integer", "minimum": 1 } }
          }
        },
        "source_model_digest": { "$ref": "#/$defs/digest" },
        "target_canonical_digest": { "$ref": "#/$defs/digest" },
        "correction_authority_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "correction_evidence_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "admitted_source_contradictions": { "type": "array", "maxItems": 100, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" } }
      }
    }
  }
}
