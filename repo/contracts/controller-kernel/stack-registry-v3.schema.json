{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.controller.stack-registry.v3",
  "title": "Toolkit V3 controller role stack registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "profiles"
  ],
  "properties": {
    "schema": {
      "const": "toolkit.controller.stack-registry.v3"
    },
    "version": {
      "const": 3
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner-gpt",
        "owner-claude"
      ],
      "properties": {
        "owner-gpt": {
          "$ref": "#/$defs/currentProfile"
        },
        "owner-claude": {
          "$ref": "#/$defs/currentProfile"
        }
      }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "reasoning"
      ],
      "properties": {
        "provider": {
          "enum": [
            "openai",
            "anthropic"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "reasoning": {
          "enum": [
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "provider",
        "model",
        "reasoning"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "enum": [
            "sol",
            "opus"
          ]
        },
        "provider": {
          "enum": [
            "openai",
            "anthropic"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "reasoning": {
          "enum": [
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      }
    },
    "currentProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routes",
        "reviewers"
      ],
      "properties": {
        "routes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "DISCOVERY",
            "DISCOVERY_HELPER",
            "BUILDER",
            "BUILDER_HELPER",
            "DESIGN_CHALLENGE"
          ],
          "properties": {
            "DISCOVERY": {
              "$ref": "#/$defs/route"
            },
            "DISCOVERY_HELPER": {
              "$ref": "#/$defs/route"
            },
            "BUILDER": {
              "$ref": "#/$defs/route"
            },
            "BUILDER_HELPER": {
              "$ref": "#/$defs/route"
            },
            "DESIGN_CHALLENGE": {
              "$ref": "#/$defs/route"
            }
          }
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/reviewer"
          }
        }
      }
    }
  }
}
