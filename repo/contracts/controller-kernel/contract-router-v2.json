{
  "schema": "toolkit.controller.contract-router.v2",
  "version": 2,
  "route_identity": ["provider", "model", "reasoning"],
  "selection_precedence": [
    "explicit-trusted-selected-stack",
    "ROUTE_UNAVAILABLE"
  ],
  "harness_context": {
    "authority": "capability-and-adapter-context-only",
    "selects_stack": false,
    "manufactures_stack": false
  },
  "roles": ["G0-A", "G0-B", "G1", "G2", "G3", "G4", "LOOP", "RECONVERGENCE", "FINAL_AUDIT", "BROWSER"],
  "semantic_subagent_roles": ["G0-B", "G3"],
  "unavailable_route": {
    "status": "ROUTE_UNAVAILABLE",
    "silent_substitution": false,
    "repair_budget_consumed": false
  },
  "execution": {
    "before_a2_acceptance": "direct-web-executor-web-reconciliation",
    "after_a2_acceptance": "already-authorised-equivalent-reconciliation",
    "loop_manager_required_for_c1": false
  },
  "ownership": {
    "active_overlap_scope": "repository-and-overlapping-toolkit-work",
    "timeout_transfers_owner": false,
    "heartbeat_transfers_owner": false,
    "labels_are_authority": false,
    "executor_replacement_transfers_owner": false,
    "ambiguous_owner_status": "USER_DECISION_REQUIRED"
  },
  "repository_fence": {
    "controller_repository_fence": "one-exact-bound-repository",
    "cross_repository_reads": "evidence-only",
    "cross_repository_mutation": "CROSS_REPOSITORY_MUTATION_DENIED",
    "observer_mutation": "OBSERVER_MUTATION_DENIED",
    "timeout_self_promotion": false,
    "takeover_requires": ["explicit-user-web-authority", "prior-in-flight-admission-reconciliation"]
  },
  "current_launch_safety": {
    "in_flight_launch": "CURRENT_STATE_INVARIANT_VIOLATION",
    "unverified_worker_liveness": "WORKER_LIVENESS_UNVERIFIED",
    "worker_liveness_reconciliation": "RECONCILE_WORKER_LIVENESS",
    "ambiguous_launch": "RECONCILE_LAUNCH_OUTCOME",
    "returned_terminal_packet": "RECONCILE_TERMINAL_PACKET",
    "terminal_non_convergence": "HOLD_TERMINAL_NON_CONVERGENCE",
    "safe_direct_launch": "no-active-or-ambiguous-worker-and-authorised-stage"
  }
}
