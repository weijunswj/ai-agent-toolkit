        "physical_available": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "commit_total": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "commit_available": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "host_responsive": { "const": true }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "physical_total", "physical_available", "commit_total", "commit_available", "host_responsive"],
      "properties": {
        "source": { "const": "win32-operating-system" },
        "physical_total": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "physical_available": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "commit_total": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "commit_available": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "host_responsive": { "const": true }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
