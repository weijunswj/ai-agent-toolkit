{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "decision_digest",
    "qualification_digest",
    "executable",
    "protocol",
    "host",
    "route",
    "role",
    "instruction_digest",
    "policy_digest",
    "source_digest",
    "thread",
    "turn",
    "dispatch_id",
    "status",
    "source"
  ],
  "properties": {
    "schema": {
      "const": "toolkit.codex-host-adapter.v1"
    },
    "kind": {
      "enum": [
        "QUALIFICATION",
        "REQUEST",
        "RECEIPT"
      ]
    },
    "decision_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "qualification_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_digest",
        "version"
      ],
      "properties": {
        "schema_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cwd"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "reasoning"
      ],
      "properties": {
        "provider": {
          "enum": [
            "openai",
            "anthropic"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "reasoning": {
          "enum": [
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      }
    },
    "role": {
      "enum": [
        "DISCOVERY",
        "DISCOVERY_HELPER",
        "BUILDER",
        "BUILDER_HELPER",
        "REVIEW_SCOPE",
        "REVIEW_EXECUTION",
        "DESIGN_CHALLENGE"
      ]
    },
    "instruction_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "thread": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        }
      ]
    },
    "turn": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        }
      ]
    },
    "dispatch_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        }
      ]
    },
    "status": {
      "enum": [
        "QUALIFIED",
        "REQUESTED",
        "RUNNING",
        "COMPLETED",
        "PROVEN_NOT_STARTED",
        "INTERRUPTED_KNOWN_EFFECTS",
        "UNKNOWN_EFFECTS",
        "HOLD"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "revision",
        "path",
        "content_sha256",
        "blob_sha1"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "blob_sha1": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          ]
        }
      }
    }
  },
  "$id": "toolkit.codex-host-adapter.v1"
}
