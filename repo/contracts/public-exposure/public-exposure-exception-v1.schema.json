{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolkit.public-exposure.exception.v1",
  "title": "Toolkit intentional public exposure exception",
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "name", "surface", "reason", "scope", "authority", "expires_at"],
  "properties": {
    "category": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,127}$" },
    "surface": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,127}$" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
    "scope": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,127}$" },
    "authority": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,127}$" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
