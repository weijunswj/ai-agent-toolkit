{
  "schema": "toolkit.cloud-jobs.v1",
  "app": {
    "client_id_variable": "TOOLKIT_GOVERNANCE_APP_CLIENT_ID",
    "private_key_secret": "TOOLKIT_GOVERNANCE_APP_PRIVATE_KEY"
  },
  "never_granted": [
    "administration",
    "secrets",
    "workflows",
    "account"
  ],
  "jobs": [
    {
      "id": "programme-sweep",
      "workflow": ".github/workflows/toolkit-programme-sweep.yml",
      "schedule": {
        "cadence": "hourly",
        "cron": "17 * * * *"
      },
      "replaces_laptop_job": "toolkit-programme-sweep",
      "tokens": [
        {
          "name": "governed",
          "repository": "governed_repository",
          "permissions": {
            "issues": "write",
            "pull_requests": "write",
            "contents": "read",
            "checks": "read",
            "statuses": "read"
          }
        },
        {
          "name": "store",
          "repository": "evidence_store",
          "permissions": {
            "contents": "write"
          }
        }
      ]
    }
  ]
}
