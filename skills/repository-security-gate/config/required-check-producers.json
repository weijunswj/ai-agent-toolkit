    "source_files": [
      "package.json",
      "package-lock.json",
      "wrangler.jsonc",
      "src/worker.mjs",
      "src/producer-inventory.mjs",
      "src/evidence-verifier.mjs",
      "src/check-publisher.mjs",
      "src/run-state.mjs",
      "src/canonical-json.mjs"
