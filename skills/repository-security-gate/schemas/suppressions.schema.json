{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weijunswj.github.io/ai-agent-toolkit/security-gate/suppressions.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "authority_source",
    "authority_binding",
    "suppressions"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "authority_source": {
      "const": "protected-trusted-checkout"
    },
    "authority_binding": {
      "const": "exact-runtime-trusted-authority"
    },
    "suppressions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tool",
          "rule",
          "finding_identity",
          "path",
          "scope",
          "exploitability_rationale",
          "approver_reference",
          "introduction_commit",
          "expires",
          "trusted_invariant_id",
          "trusted_invariant_closure_sha256",
          "candidate_input_contract",
          "tool_version",
          "rule_version",
          "source_sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "finding_identity": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)(?!.*[*?]).+$",
            "description": "Exact-case repository-relative Git path."
          },
          "scope": {
            "enum": [
              "exact_path",
              "exact_line",
              "synthetic_fixture"
            ]
          },
          "exploitability_rationale": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000
          },
          "approver_reference": {
            "type": "string",
            "pattern": "^https://github\\.com/weijunswj/ai-agent-toolkit/(?:issues/\\d+|pull/\\d+#discussion_r\\d+)$"
          },
          "introduction_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "expires": {
            "type": "string",
            "format": "date"
          },
          "trusted_invariant_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "trusted_invariant_closure_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "candidate_input_contract": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*\\.\\.)(?!.*[*?]).+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "tool_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "rule_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
