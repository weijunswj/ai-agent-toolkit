# host-observability settings. The installer copies this file to /etc/host-observability/host-pulse.env
# with mode 600. Edit it on the host only. Keep real tokens, chat IDs, webhook URLs, heartbeat URLs and
# email addresses out of chat and out of git. systemd reads this file, not a shell: quote a value that
# has spaces, and send the test alert through the test unit (references/alert-options.md).

# Display name used in reports and alerts. Defaults to the host name.
# HOST_LABEL=my-server

# --- Alerts: no channel is chosen by default. Ask the owner, then set one or more. ---------------
# Options and trade-offs: references/alert-options.md. Until a channel is set, reports stay on the
# host and the pulse shows OBSERVABILITY_DEGRADED.
# systemd does not allow comments after a value, so keep each value on a line of its own.
# Any of telegram, email, webhook, comma separated.
# ALERT_CHANNELS=webhook

# Webhook: Slack or Discord incoming webhook, an ntfy topic URL, or any endpoint that accepts a POST.
# Use https; plain http is accepted only to this host itself.
# ALERT_WEBHOOK_URL=replace-with-owner-webhook-url
# One of json, slack, discord, ntfy or text.
# ALERT_WEBHOOK_FORMAT=json

# Telegram bot.
# TELEGRAM_BOT_TOKEN=replace-with-owner-bot-token
# TELEGRAM_CHAT_ID=replace-with-owner-chat-id
# TELEGRAM_THREAD_ID=replace-with-topic-id-if-needed

# Email through mail or sendmail on the host. The pulse's sandbox cannot write a local mail queue,
# so use a mailer that relays straight out. Its config holds the SMTP password: make it readable by
# host-pulse only (owner root, group host-pulse, mode 640), never world-readable.
# SENDMAIL=/usr/sbin/sendmail
# ALERT_EMAIL_TO=replace-with-owner-address
# ALERT_EMAIL_SUBJECT_PREFIX=[host-observability]

# --- Off-host heartbeat: no service is chosen by default. Ask the owner, then set one. ----------
# A dead-man's-switch check that alarms when pings stop. The pulse pings it every run. Use https.
# HEARTBEAT_URL=replace-with-owner-heartbeat-ping-url
# Optional: a second URL the pulse pings instead when the host is in EMERGENCY_PRESSURE or
# OBSERVABILITY_DEGRADED, for services that support a "fail" ping.
# HEARTBEAT_FAIL_URL=replace-with-owner-heartbeat-fail-url

# --- What to watch -------------------------------------------------------------------------------
# The service sandbox hides /home, /root and /run/user, so paths there are reported as not checked.
# DISK_PATHS="/ /data"
# Plain health URLs with no credentials or token-like query values.
# HEALTHCHECK_URLS="https://app.example.com/health https://api.example.com/health"
# Containers that may stay stopped with a non-zero exit code, such as one-off jobs.
# DOCKER_EXITED_OK_CONTAINERS="backup-job migrate"

# --- Thresholds (percent unless stated). These are per-host settings; tune them to the host. -----
# DISK_REVIEW_PCT=75
# DISK_UPGRADE_PCT=85
# DISK_EMERGENCY_PCT=95
# INODE_REVIEW_PCT=75
# INODE_UPGRADE_PCT=85
# INODE_EMERGENCY_PCT=95
# MEM_REVIEW_PCT=75
# MEM_UPGRADE_PCT=85
# MEM_EMERGENCY_PCT=95
# SWAP_REVIEW_PCT=25
# SWAP_UPGRADE_PCT=50
# SWAP_EMERGENCY_PCT=90
# 15-minute load as a percent of CPU count. Review and upgrade count only after this many pulses in
# a row over the review threshold; emergency counts at once.
# LOAD_REVIEW_PCT=80
# LOAD_UPGRADE_PCT=150
# LOAD_EMERGENCY_PCT=300
# LOAD_SUSTAIN_PULSES=2
# Disk use that grew by this many percentage points since the last pulse needs a review.
# DISK_GROWTH_REVIEW_POINTS=5
# New out-of-memory kills and container restarts since the last pulse.
# OOM_REVIEW_KILLS=1
# OOM_UPGRADE_KILLS=2
# RESTART_REVIEW_COUNT=1
# RESTART_UPGRADE_COUNT=3
# Whole minutes without a pulse before the host counts as degraded (the timer runs hourly).
# PULSE_STALE_MINUTES=60
# REPORT_KEEP=72
